            },
            "H3": {
              "text-align": "left",
              "color": "#ffffff"
            },
            "P": {
              "color": "#ffffff"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left"
            },
            ".icons-menu .soc-item .mbr-iconfont": {
              "color": "#fdc205 ",
              "border-color": "#fdc205 "
            },
            ".icons-menu .soc-item .mbr-iconfont:hover": {
              "background-color": "#fdc205 ",
              "color": "#2d2d2d"
            },
            ".align-right-style": {
              "text-align": "right",
              "@media (max-width: 778px)": {
                "text-align": "left",
                "margin-top": "2rem"
              }
            },
            "@media (max-width: 778px)": {
              "padding-top": "(@paddingTop * 0.5rem)",
              "padding-bottom": "(@paddingBottom * 0.5rem)",
              ".icons-menu": {}
            }
