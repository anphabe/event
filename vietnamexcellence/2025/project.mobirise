              "background-color": "#fdc205",
              "width": "10%"
            },
            ".btn-primary, .btn-primary:active": {
              "color": "#2d2d2d!important",
              "font-weight": "bolder"
            }
          },
          "_name": "pricing2",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" group=\"Pricing Tables\" class=\"pricing2\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <select title=\"Amount\" name=\"itemsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg3.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\">\n            <input type=\"video\" title=\"Video\" value=\"https://youtu.be/v9GiWH664XI\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#041223\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"title col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>GIÁ VÉ THAM DỰ</b></h3>   \n            </div>\n            <div class=\"col-12 col-md-6 align-center\" mbr-class=\"{'col-lg-4': itemsAmount == 3,\n                                            'col-lg-6': itemsAmount == 2,\n                                            'col-lg-4': itemsAmount == 4}\">\n                <div class=\"plan\">\n                    <div class=\"plan-header\">\n                        <h6 class=\"plan-title mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" data-app-selector=\".plan-title\"><b>Hội nghị và Vinh danh</b></h6>\n                        <div class=\"plan-price\">\n                            <p mbr-text class=\"price mbr-fonts-style m-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price\"><b>5.200.000&nbsp;</b><br></p>\n                            <p mbr-text class=\"price-term mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" data-app-selector=\".price-term\"><b>VNĐ/VÉ</b></p>\n                        </div>\n                    </div>\n                    <div class=\"plan-body\">\n                        <div class=\"plan-list mb-4\">\n                            <ul mbr-text class=\"list-group mbr-fonts-style list-group-flush\" mbr-theme-style=\"display-7\">\n                                <li class=\"list-group-item\">Thời gian tham dự: <br><b>Thứ Tư - 24.04.2025</b><br><b>17:00 - 21:00</b></li>\n                            </ul>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn text-center\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"https://event-register.anphabe.com/register.vi.html\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">ĐĂNG KÝ NGAY</a></div>\n                    </div>\n                </div>\n            </div>\n            \n            <div class=\"col-12 col-md-6 align-center\" mbr-if=\"itemsAmount > 3\" mbr-class=\"{'col-lg-4': itemsAmount == 3,\n                                            'col-lg-6': itemsAmount == 2,\n                                            'col-lg-4': itemsAmount == 4}\">\n                <div class=\"plan\">\n                    <div class=\"plan-header\">\n                        <h6 class=\"plan-title mbr-fonts-style mb-3\" mbr-theme-style=\"display-5\" data-app-selector=\".plan-title\"><b>ƯU ĐÃI ĐẶC BIỆT</b></h6>\n                        <div class=\"plan-price\">\n                            <p mbr-text class=\"price mbr-fonts-style m-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price\"><b>20%</b></p>\n                        </div>\n                    </div>\n                    <div class=\"plan-body\">\n                        <div class=\"plan-list mb-4\">\n                            <ul mbr-text class=\"list-group mbr-fonts-style list-group-flush\" mbr-theme-style=\"display-7\">\n                                <li class=\"list-group-item\"><span style=\"background-color: transparent; font-size: 1.2rem;\">Early bird<br><b>(tới 12.04.2025)</b></span><br></li>\n                                <li class=\"list-group-item\">HOẶC&nbsp;<span style=\"background-color: transparent; font-size: 1rem;\">Nhóm từ&nbsp;</span><b style=\"background-color: transparent; font-size: 1rem;\">3</b><span style=\"background-color: transparent; font-size: 1rem;\"> người</span><br></li>\n                            </ul>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn text-center\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a href=\"https://event-register.anphabe.com/register.vi.html\" class=\"btn btn-primary\" data-app-placeholder=\"Type Text\">ĐĂNG KÝ NGAY</a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "thY5j53c25",
          "_anchor": "ve",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when not (@spacing)": {
              ".row": {
                "margin-left": "0",
                "margin-right": "0"
              },
              ".item": {
                "padding-left": "0",
                "padding-right": "0"
              }
            },
            "& when (@spacing)": {
              ".item": {
                "padding-bottom": "2rem",
                "display": "flex",
                "align-items": "center",
                "@media (min-width: 768px)": {
                  "display": "block"
                }
              }
            },
            ".item-wrapper": {
              "& when (@autoSize)": {
                "& when not (@showItemSubtitle)": {
                  "height": "100%"
                },
                "& when (@showItemSubtitle)": {
                  "height": "(@imageHeight * 100px)"
                },
                "img": {
                  "height": "100%",
                  "object-fit": "cover"
                }
              },
              "position": "relative",
              ".icon-wrapper": {
                "pointer-events": "none",
                "position": "absolute",
                "width": "60px",
                "height": "60px",
                "font-size": "22px",
                "left": "50%",
                "top": "50%",
                "display": "flex",
                "align-items": "center",
                "justify-content": "center",
                "border": "2px solid #ffffff",
                "border-radius": "50%",
                "opacity": "0",
                "color": "#ffffff",
                "transform": "translateX(-50%) translateY(-50%)",
                "background-color": "#1b1b1b",
                "transition": "0.2s"
              },
              "&:hover": {
                ".icon-wrapper": {
                  "opacity": "0.7"
                }
              },
              "width": "300px",
              "@media (min-width: 768px)": {
                "width": "auto"
              },
              "@media (max-width: 767px)": {
                "position": "relative",
                "width": "40%"
              }
            },
            ".carousel-control, .close": {
              "background": "#1b1b1b"
            },
            ".carousel-control-prev": {
              "margin-left": "2.5rem",
              "span": {
                "margin-right": "5px"
              }
            },
            ".carousel-control-next": {
              "margin-right": "2.5rem",
              "span": {
                "margin-left": "5px"
              }
            },
            ".close": {
              "position": "fixed",
              "opacity": "0.5",
              "font-size": "22px",
              "font-weight": "300",
              "width": "60px",
              "height": "60px",
              "border-radius": "50%",
              "color": "#fff",
              "top": "2.5rem",
              "right": "2.5rem",
              "border": "2px solid #fff",
              "text-shadow": "none",
              "z-index": "5",
              "transition": "opacity 0.3s ease",
              "font-family": "'Moririse2'",
              "align-items": "center",
              "justify-content": "center",
              "display": "flex",
              "&::before": {
                "content": "'\\e91a'"
              },
              "&:hover": {
                "opacity": "1",
                "background": "#042d66",
                "color": "#fff"
              }
            },
            ".carousel-control": {
              "display": "flex",
              "top": "50%",
              "width": "60px",
              "height": "60px",
              "margin-top": "-1.5rem",
              "font-size": "22px",
              "background-color": "#ed9d11 ",
              "border-radius": "50%",
              "opacity": "1",
              "transition": "all 0.3s",
              "&.carousel-control-prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.carousel-control-next": {
                "right": "0",
                "margin-right": "2.5rem"
              },
              "@media (max-width: 767px)": {
                "top": "auto",
                "bottom": "1rem"
              }
            },
            ".carousel-indicators": {
              "position": "absolute",
              "bottom": "0",
              "margin-bottom": "3px",
              "li": {
                "max-width": "15px",
                "height": "15px",
                "width": "15px",
                "max-height": "15px",
                "margin": "3px",
                "background-color": "rgba(0, 0, 0, 0.5)",
                "border": "2px solid #fff",
                "border-radius": "50%",
                "opacity": "0.5",
                "transition": "all 0.3s",
                "&.active, &:hover": {
                  "opacity": "0.9"
                },
                "&::after, &::before": {
                  "content": "none"
                }
              },
              "&.ie-fix": {
                "left": "50%",
                "display": "block",
                "width": "60%",
                "margin-left": "-30%",
                "text-align": "center"
              },
              "@media (max-width: 768px)": {
                "display": "none !important"
              },
              "@media (max-width: 991px)": {
                "margin-bottom": "3.625rem !important",
                "padding-left": "2.5rem",
                "padding-right": "2.5rem"
              },
              "@media (max-width: 767px)": {
                "display": "none"
              }
            },
            ".carousel-inner": {
              "display": "flex",
              "padding": "0 7rem",
              "background-color": "#ffffff",
              "@media (max-width: 768px)": {
                "overflow": "scroll"
              }
            },
            ".carousel-inner > .active": {
              "display": "block"
            },
            ".carousel-control.left": {
              "left": "0",
              "margin-left": "2.5rem"
            },
            ".carousel-control.right": {
              "right": "0",
              "margin-right": "2.5rem"
            },
            ".carousel-control:hover": {
              "background": "#ed9d11",
              "color": "#fff",
              "opacity": "1"
            },
            ".carousel-indicators .active, .carousel-indicators li": {
              "width": "7px",
              "height": "7px",
              "margin": "3px",
              "background": "#000000",
              "opacity": "0.5",
              "border": "4px solid #000000"
            },
            ".carousel-indicators .active": {
              "background": "#fff"
            },
            ".carousel-indicators li": {
              "max-width": "15px",
              "max-height": "15px",
              "border-radius": "50%"
            },
            ".modal": {
              "padding-left": "0 !important",
              "position": "fixed",
              "overflow": "hidden",
              "padding-right": "0 !important"
            },
            ".modal-dialog": {
              "margin": "0 auto",
              "max-width": "1440px",
              "background-color": "#fff"
            },
            ".modal-content": {
              "border-radius": "0",
              "border": "none",
              "background": "transparent"
            },
            ".modal-body": {
              "padding": "0",
              "display": "flex",
              "align-items": "center",
              "img": {
                "width": "100%",
                "object-fit": "contain",
                "max-height": "~\"calc(100vh - 1.75rem)\""
              }
            },
            ".carousel": {
              "width": "100%"
            },
            ".modal-backdrop.in": {
              "opacity": "0.8"
            },
            ".modal.fade .modal-dialog": {
              "transition": "margin-top 0.3s ease-out"
            },
            ".modal.fade .modal-dialog, .modal.in .modal-dialog": {
              "transform": "none"
            },
            ".mbr-gallery .item-wrapper": {
              "cursor": "pointer"
            },
            "H6": {
              "text-align": "center",
              "color": "#ffffff"
            },
            ".content-bio": {
              "text-align": "left",
              "padding-right": "2rem",
              "padding-left": "2rem",
              "@media (max-width: 767px)": {
                "padding": "2rem 0 5rem"
              }
            },
            ".winner-intro": {
              "text-align": "left",
              "text-transform": "uppercase",
              "color": "#969696",
              "font-weight": "bold",
              "font-size": "1.6rem!important",
              "line-height": "1.4!important"
            },
            "h1.winner-name": {
              "line-height": "1.6",
              "color": "#1a1a1a",
              "text-transform": "capitalize",
              "font-family": "'Nunito', sans-serif"
            },
            ".ul": {
              "margin-left": "-20px"
            },
            ".title-category": {
              "color": "#ed9d11"
            },
            "h6.display-7": {
              "font-size": "1rem!important"
            },
            "@media (max-width: 767px)": {
              ".carousel-control, .carousel-indicators, .modal .close": {
                "position": "fixed"
              },
              ".carousel-inner": {
                "padding": "0 2rem"
              },
              ".close": {
                "top": "0",
                "right": "0"
              },
              ".mbr-slider .carousel-control": {
                "top": "auto",
                "bottom": "20px"
              },
              ".mbr-slider > .container .carousel-control": {
                "margin-bottom": "0"
              },
              ".winner-caption": {
                "text-align": "left!important",
                "margin-left": "0",
                "width": "100%"
              },
              ".align-center": {
                "text-align": "left!important"
              },
              ".item": {
                "padding-bottom": "10px",
                "height": "auto",
                "display": "block"
              },
              ".item-wrapper": {
                "width": "100%"
              }
            },
            ".winner-caption": {
              "@media (max-width: 767px)": {
                "margin-left": "0",
                "width": "calc(100% - 10px)"
              }
            },
            ".listcontent": {
              "position": "relative",
              "padding-left": "2rem"
            },
            ".listcontent::before": {
              "position": "absolute",
              "left": "0px",
              "top": "15px",
              "transform": "translateY(-50%)",
              "width": "30px",
              "font-weight": "900",
              "content": "\"✓\"",
              "color": "rgb(0, 0, 0)",
              "height": "30px",
              "display": "flex"
            },
            ".mbr-item-subtitle.display-7": {
              "line-height": "1.4rem"
            },
            "@media (max-width: 992px)": {
              "h1.winner-name": {
                "line-height": "1.2!important"
              },
              ".content-bio p.display-7": {
                "font-size": "1rem!important"
              },
              ".winner-intro .display-2": {
                "font-size": "1.6rem!important"
              }
            },
            "H4": {
              "text-align": "center",
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            }
          },
          "_name": "gallery5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery5 mbr-gallery\" group=\"Sliders & Galleries\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\">\n    <mbr-parameters>\n        <input type=\"id\" name=\"idGallery\">\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <select title=\"Columns\" name=\"cardsWidth\">\n            <option value=\"12\">1</option>\n            <option value=\"6\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Images</header>\n        <input type=\"checkbox\" title=\"Auto Size\" name=\"autoSize\">\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"autoSize && showItemSubtitle\">\n        <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\" checked>\n        <input type=\"checkbox\" title=\"Caption\" name=\"showItemSubtitle\" checked>\n        <header>Popup Slider</header>\n        <input type=\"checkbox\" title=\"Fade Effect\" name=\"fade\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"3\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg-kv.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#01264d\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type!=='color'\">Overlay</header>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">        \n        <div class=\"row justify-content-center\">\n            <div class=\"title col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-4\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>BAN CỐ VẤN CHƯƠNG TRÌNH</b></h3>\n                <h4 class=\"mbr-section-subtitle align-center mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\">\n                    You can arrange your articles with the Mobirise website design software.\n                </h4>\n                <div class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\">\n                    <a class=\"btn btn-primary\" href=\"https://mobiri.se\">LEARN MORE</a>\n                    <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\">LIVE DEMO</a>\n                </div>\n            </div>\n        </div>\n        <div class=\"row mbr-gallery\">\n            <div class=\"col-12 col-md-4 col-lg-{{cardsWidth}} item gallery-image active\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100 image-speaker\" src=\"@PROJECT_PATH@/assets/images/khuong.jpg\" alt=\"GS.TS. NGUYỄN ĐỨC KHƯƠNG\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                    <div class=\"icon-wrapper\">\n                        <span class=\"mobi-mbri mobi-mbri-search mbr-iconfont mbr-iconfont-btn\"></span>\n                    </div>\n                </div>\n                <div class=\"winner-caption\">\n                    <h4 class=\"mbr-item-subtitle mbr-fonts-style align-center mt-4 \" mbr-theme-style=\"display-5\" mbr-if=\"showItemSubtitle\">GS.TS. <b>NGUYỄN ĐỨC KHƯƠNG</b></h4>\n                    <h6 class=\"mbr-item-subtitle mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showItemSubtitle\">Chủ tịch, Tổ chức Khoa học và Chuyên gia Việt Nam toàn cầu (AVSE Global)<br>Giám đốc điều hành, EMLV Business School (Pháp)<br>Giám đốc phát triển quốc tế, Tổ hợp đại học Leonard de Vinci (Pháp)</h6>\n                </div>\n            </div><div class=\"col-12 col-md-4 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100 image-speaker\" src=\"@PROJECT_PATH@/assets/images/thanhs.jpg\" alt=\"Ông VÕ TÂN THÀNH\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                    <div class=\"icon-wrapper\">\n                        <span class=\"mobi-mbri mobi-mbri-search mbr-iconfont mbr-iconfont-btn\"></span>\n                    </div>\n                </div>\n                <div class=\"winner-caption\">\n                    <h4 class=\"mbr-item-subtitle mbr-fonts-style align-center mt-4 \" mbr-theme-style=\"display-5\" mbr-if=\"showItemSubtitle\">Ông <b>VÕ TÂN THÀNH</b></h4>\n                    <h6 class=\"mbr-item-subtitle mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showItemSubtitle\">Phó Chủ tịch Phòng Thương mại và Công nghiệp Việt Nam (VCCI)</h6>\n                </div>\n            </div>\n                        \n            <div class=\"col-12 col-md-4 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/thanh.jpg\" alt=\"Bà THANH NGUYỄN\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                    <div class=\"icon-wrapper\">\n                        <span class=\"mobi-mbri mobi-mbri-search mbr-iconfont mbr-iconfont-btn\"></span>\n                    </div>\n                </div>\n                <div class=\"winner-caption\">\n                    <h4 class=\"mbr-item-subtitle mbr-fonts-style align-center mt-4\" mbr-theme-style=\"display-5\" mbr-if=\"showItemSubtitle\">Bà&nbsp;<b>THANH NGUYỄN</b></h4>\n                    <h6 class=\"mbr-item-subtitle mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showItemSubtitle\">Giám đốc Điều hành &amp; Truyền cảm hứng Hạnh phúc - Anphabe</h6>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-4 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100 image-speaker\" src=\"@PROJECT_PATH@/assets/images/jesse.jpg\" alt=\"Ông JESSE BOONE\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                    <div class=\"icon-wrapper\">\n                        <span class=\"mobi-mbri mobi-mbri-search mbr-iconfont mbr-iconfont-btn\"></span>\n                    </div>\n                </div>\n                <div class=\"winner-caption\">\n                    <h4 class=\"mbr-item-subtitle mbr-fonts-style align-center mt-4 \" mbr-theme-style=\"display-5\" mbr-if=\"showItemSubtitle\">Ông&nbsp;<b>JESSE BOONE</b></h4>\n                    <h6 class=\"mbr-item-subtitle mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showItemSubtitle\">Thành viên Hội đồng Quản trị, Phòng Thương mại Hoa Kỳ tại Việt Nam (AmCham)</h6>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-4 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/winnie-1.jpg\" alt=\"Bà WINNIE LAM\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                    <div class=\"icon-wrapper\">\n                        <span class=\"mobi-mbri mobi-mbri-search mbr-iconfont mbr-iconfont-btn\"></span>\n                    </div>\n                </div>\n                <div class=\"winner-caption\">\n                    <h4 class=\"mbr-item-subtitle mbr-fonts-style align-center  mt-4 title\" mbr-theme-style=\"display-5\" mbr-if=\"showItemSubtitle\">Bà<b> WINNIE LAM</b></h4>\n                    <h6 class=\"mbr-item-subtitle mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showItemSubtitle\">Thành viên Hội đồng quản trị, Tổng Thư ký, Hiệp hội Doanh nghiệp Hồng Kông tại Việt Nam (HKBAV)</h6>   \n                </div>\n            </div>\n            <div class=\"col-12 col-md-4 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100 image-speaker\" src=\"@PROJECT_PATH@/assets/images/mike.jpg\" alt=\"Ông MIKE HEBERT\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"5\" data-bs-slide-to=\"5\">\n                    <div class=\"icon-wrapper\">\n                        <span class=\"mobi-mbri mobi-mbri-search mbr-iconfont mbr-iconfont-btn\"></span>\n                    </div>\n                </div>\n                <div class=\"winner-caption\">\n                    <h4 class=\"mbr-item-subtitle mbr-fonts-style align-center  mt-4 \" mbr-theme-style=\"display-5\" mbr-if=\"showItemSubtitle\">Ông <b>MIKE HEBERT</b></h4>\n                    <h6 class=\"mbr-item-subtitle mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showItemSubtitle\">Chủ tịch - Phòng Thương mại Canada tại Việt Nam (CanCham)</h6>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-4 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100 image-speaker\" src=\"@PROJECT_PATH@/assets/images/david.jpg\" alt=\"Ông DAVID DO\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"6\" data-bs-slide-to=\"6\">\n                    <div class=\"icon-wrapper\">\n                        <span class=\"mobi-mbri mobi-mbri-search mbr-iconfont mbr-iconfont-btn\"></span>\n                    </div>\n                </div>\n                <div class=\"winner-caption\">\n                    <h4 class=\"mbr-item-subtitle mbr-fonts-style align-center  mt-4 \" mbr-theme-style=\"display-5\" mbr-if=\"showItemSubtitle\">Ông <b>DAVID DO</b></h4>\n                    <h6 class=\"mbr-item-subtitle mbr-fonts-style align-center mb-4\" mbr-theme-style=\"display-7\" mbr-if=\"showItemSubtitle\">Giám đốc Điều hành của Vietnam Investments Group (VI Group)<br>Thành viên Hội đồng Cố vấn của Endeavor Việt Nam</h6>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"modal mbr-slider\" id=\"{{idGallery}}-modal\" tabindex=\"-1\" role=\"dialog\" aria-hidden=\"true\">\n            <div class=\"modal-dialog\" role=\"document\">\n                <div class=\"modal-content\">\n                    <div class=\"modal-body\">\n                        <div id=\"lb-{{idGallery}}\" class=\"carousel slide\" mbr-class=\"{'carousel-fade': fade}\" data-ride=\"{{autoplay ? 'carousel' : false}}\" data-bs-ride=\"{{autoplay ? 'carousel' : false}}\" data-interval=\"{{interval*1000}}\" data-bs-interval=\"{{interval*1000}}\">\n                            <div class=\"carousel-inner\">\n                                <div class=\"carousel-item active\">\n                                    <div class=\"row\">\n                                        <div class=\"col-12 winner-intro\">\n                                            <h1 class=\"mbr-section-title mbr-fonts-style m-0 winner-name mt-2\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                                                GS.TS. <b>NGUYỄN ĐỨC KHƯƠNG</b>\n                                            </h1>\n                                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                            Thành viên Tổ tư vấn kinh tế của Thủ Tướng Chính phủ<br>\n                                            Chủ tịch Tổ chức Khoa học và Chuyên gia Việt Nam toàn cầu (AVSE Global)</p>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\">\n                                            <img class=\"d-block w-100 image-speaker\" src=\"@PROJECT_PATH@/assets/images/khuong-2022.jpg\" alt>\n                                        </div>\n                                        <div class=\"col-12 col-md-8\">\n                                            <div class=\"content-bio\">\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">GS. Nguyễn Đức Khương có nhiều năm kinh nghiệm tham vấn chiến lược cho Chính phủ, địa phương và các tập đoàn đa quốc gia về phát triển bền vững. Ông cũng là Giáo sư thỉnh giảng tại Trường Quốc tế, Đại học Quốc gia Hà Nội và Đại học Kinh tế và Kinh doanh Praha.</p>\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Tháng 7/2017, ông được bổ nhiệm là thành viên Tổ tư vấn kinh tế của Thủ tướng Chính phủ Việt Nam và từ tháng 8/2023 là thành viên Hội đồng tư vấn triển khai Nghị quyết 98/2023/NQ15 của Quốc hội về chính sách phát triển TP.HCM.</p>\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Với vai trò Chủ tịch AVSE Global hoạt động tại 20 quốc gia, ông Khương thúc đẩy mạng lưới chuyên gia quốc tế đóng góp hiệu quả cho sự phát triển bền vững của Việt Nam. Ông đã trực tiếp điều hành nhiều dự án lớn của AVSE Global tại Việt Nam, đặc biệt về kinh tế số hóa, kinh tế tri thức, phát triển bền vững, xây dựng thương hiệu quốc gia và thu hút nhân tài.</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div><div class=\"carousel-item\">\n                                    <div class=\"row\">\n                                        <div class=\"col-12 winner-intro\">\n                                            <h1 class=\"mbr-section-title mbr-fonts-style m-0 winner-name mt-2\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Ông <b>VÕ TÂN THÀNH</b></h1>\n                                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                                Phó Chủ tịch Phòng Thương mại và Công nghiệp Việt Nam (VCCI)\n                                            </p>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\">\n                                            <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/tanthanh-2022.jpg\" alt>\n                                        </div>\n                                        <div class=\"col-12 col-md-8\">\n                                            <div class=\"content-bio\">\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Ông Võ Tân Thành hiện đang là Phó Chủ tịch Phòng Thương mại và Công nghiệp Việt Nam. Trải qua quá trình hơn 30 năm công tác, ông đã từng nắm giữ nhiều vị trí chủ chốt, điển hình như Phó Tổng thư ký VCCI và Giám đốc Chi nhánh VCCI-HCM. Ông đã có những đóng góp và cống hiến to lớn vào sự phát triển của cộng đồng doanh nghiệp tại Việt Nam.</p>\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Tốt nghiệp trường Đại học Ngoại thương và Học viện Chính trị Quốc gia Hồ Chí Minh, những kiến thức chuyên sâu về kinh tế và thị trường sẽ luôn là một trong những thế mạnh hàng đầu của ông.</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                                                \n                                \n                                \n                                <div class=\"carousel-item\">\n                                    <div class=\"row\">\n                                        <div class=\"col-12 winner-intro\">\n                                            <h1 class=\"mbr-section-title mbr-fonts-style m-0 winner-name mt-2\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                                                Bà <b>THANH NGUYỄN</b>\n                                            </h1>\n                                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                            Giám đốc Điều hành &amp; Truyền cảm hứng Hạnh phúc - Anphabe</p>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\">\n                                            <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/tn.jpg\" alt>\n                                        </div>\n                                        <div class=\"col-12 col-md-8\">\n                                            <div class=\"content-bio\">\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Trên hành trình trở thành “Người truyền cảm hứng – mang tới những thay đổi tích cực cho người đi làm”, bà Thanh Nguyễn và các cộng sự đã sáng lập Anphabe vào năm 2011 với sứ mệnh: “Đồng hành cùng các doanh nghiệp nhằm xây dựng Nơi Làm Việc Hạnh Phúc &amp; tốt đẹp hơn, đồng thời truyền cảm hứng tới hàng triệu người đi làm giúp họ nhận ra và tận hưởng các giá trị trong công việc &amp; cuộc sống.”</p>\n                                                 <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Gắn liền với vai trò kết nối và tư vấn doanh nghiệp xây dựng Nguồn Nhân lực Hạnh phúc, bà Thanh Nguyễn và các cộng sự ở Anphabe đã tiên phong, cung cấp các giải pháp và sáng tạo nhiều chương trình khác nhau nhằm tạo điều kiện để các công ty trao đổi kinh nghiệm thực tiễn và học hỏi lẫn nhau.</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <div class=\"row\">\n                                        <div class=\"col-12 winner-intro\">\n                                            <h1 class=\"mbr-section-title mbr-fonts-style m-0 winner-name mt-2\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Ông <b>JESSE BOONE</b></h1>\n                                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Thành viên Hội đồng Quản trị, Phòng Thương mại Hoa Kỳ tại Việt Nam (AmCham)</p>\n                                            \n                                        </div>\n                                        <div class=\"col-12 col-md-4\">\n                                            <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/mr-jesse-boone-amcham.jpg\" alt>\n                                        </div>\n                                        <div class=\"col-12 col-md-8\">\n                                            <div class=\"content-bio\">\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                                    Với gần 15 năm kinh nghiệm sinh sống và làm việc tại Việt Nam, ông Jesse Boone đã trở thành một nhân vật quan trọng trong sự phát triển của các tổ chức giáo dục tại đây. Kể từ năm 2018, ông đảm nhận vai trò Giám đốc Cơ sở và Phát triển Khuôn viên của Đại học Fulbright Việt Nam, dẫn dắt việc quy hoạch và xây dựng khuôn viên chính của trường trên diện tích 15 ha. Trước đó, ông đã có kinh nghiệm giám sát giai đoạn đầu của khuôn viên Đại học Anh Quốc Việt Nam tại Hà Nội và quản lý khu phức hợp Indochina Plaza Hanoi (IPH) thuộc Indochina Capital.</p>\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                                    Ông Jesse đã từng tham gia hội đồng quản trị AmCham Hà Nội trong hai nhiệm kỳ và hiện đang là thành viên Hội đồng Quản trị của AmCham tại TP.HCM và Đà Nẵng. Sự tham gia của ông trong AmCham đã đóng vai trò quan trọng trong việc hỗ trợ các doanh nghiệp Hoa Kỳ hoạt động tại Việt Nam, góp phần vào các nỗ lực vận động chính sách và phát triển cơ hội mới cho các thành viên. Sự lãnh đạo và cam kết của ông đối với cộng đồng AmCham tiếp tục củng cố và gia tăng tầm ảnh hưởng của tổ chức này tại Việt Nam.</p>                                              \n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n\n                                <div class=\"carousel-item\">\n                                    <div class=\"row\">\n                                        <div class=\"col-12 winner-intro\">\n                                            <h1 class=\"mbr-section-title mbr-fonts-style m-0 winner-name mt-2\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Bà <b>WINNIE LAM</b></h1>\n                                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                            Thành viên Hội đồng quản trị, Tổng Thư ký, Hiệp hội Doanh nghiệp Hồng Kông tại Việt Nam (HKBAV)</p>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\">\n                                            <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/winnie.jpg\" alt>\n                                        </div>\n                                        <div class=\"col-12 col-md-8\">\n                                            <div class=\"content-bio\">\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                                    Với hơn 25 năm kinh nghiệm quản lý tại Canada, Hồng Kông, Trung Quốc, Thái Lan và Việt Nam, bà Winnie Lam sở hữu thế mạnh từ mạng lưới quốc tế kết hợp am hiểu sâu sắc về địa phương, và là một trong những chuyên gia hàng đầu tại thị trường Việt Nam. Bà có kiến thức sâu rộng và kinh nghiệm dày dặn trong hoạt động vận hành, quản trị thay đổi, kiểm soát rủi ro và quản lý doanh nghiệp, đồng thời có kinh nghiệm Quản lý Doanh thu, từng giữ vị trí Giám đốc Quốc gia và Tổng Giám đốc cho nhiều tổ chức. Bà đã xây dựng và lãnh đạo thành công nhiều dự án tái cơ cấu và tái tổ chức, ghi dấu ấn cộng đồng mạnh mẽ tại Việt Nam và cũng là diễn giả thường xuyên về các chủ đề nhân sự, pháp chế và vận hành.</p>\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                                    Bà chia sẻ: “Chương trình Chứng nhận Xuất sắc Vietnam Excellence là một nền tảng giá trị nhằm ghi nhận những thực hành xuất sắc của doanh nghiệp và các lãnh đạo, thúc đẩy chia sẻ kiến thức và kinh nghiệm, qua đó đóng góp vào sự phát triển dài lâu của cộng đồng kinh doanh tại Việt Nam.”</p>\n                                               \n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n\n                                <div class=\"carousel-item\">\n                                    <div class=\"row\">\n                                        <div class=\"col-12 winner-intro\">\n                                            <h1 class=\"mbr-section-title mbr-fonts-style m-0 winner-name mt-2\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Ông <b>MIKE HEBERT</b></h1>\n                                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Chủ tịch - Phòng Thương mại Canada tại Việt Nam (CanCham)</p>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\">\n                                            <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/mr-mike.jpg\" alt>\n                                        </div>\n                                        <div class=\"col-12 col-md-8\">\n                                            <div class=\"content-bio\">\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Từ năm 2015, ông Mike Hebert đã có những đóng góp quan trọng vào giáo dục và kinh doanh tại Việt Nam. Trên cương vị Chủ tịch Phòng Thương mại Canada tại Việt Nam (CanCham), ông dẫn dắt các sáng kiến chiến lược, phát triển thành viên và tài trợ, tổ chức sự kiện uy tín, xây dựng hợp tác quốc tế nhằm thúc đẩy tăng trưởng kinh tế.</p>\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Hiện ông là Giám đốc Thương mại Quốc gia của Cognita Group, quản lý chiến lược thương mại cho ba trường hàng đầu: ISHCMC, AAVN và International School of Saigon Pearl. Ông Mike tốt nghiệp Cử nhân Quản trị Kinh doanh từ Đại học St. Francis Xavier và Thạc sĩ Quản trị Kinh doanh cấp cao từ Đại học Québec tại Montréal.</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n\n                                <div class=\"carousel-item\">\n                                    <div class=\"row\">\n                                        <div class=\"col-12 winner-intro\">\n                                            <h1 class=\"mbr-section-title mbr-fonts-style m-0 winner-name mt-2\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Ông <b>DAVID DO</b></h1>\n                                            <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Giám đốc Điều hành của Vietnam Investments Group (VI Group)<br>Thành viên Hội đồng Cố vấn của Endeavor Việt Nam</p>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\">\n                                            <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/david-do-vnex.jpg\" alt>\n                                        </div>\n                                        <div class=\"col-12 col-md-8\">\n                                            <div class=\"content-bio\">\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Ông David Do là Giám đốc Điều hành của Vietnam Investments Group (VI Group) - một công ty đầu tư quản lý hơn 600 triệu USD. Ông là một nhà lãnh đạo uy tín trong các lĩnh vực đầu tư, quản lý chiến lược và phát triển kinh doanh. Ông từng là Giám đốc Điều hành tại Microsoft, phụ trách Chiến lược, Mua bán &amp; Sáp nhập, Đầu tư và Liên doanh cho các mảng Windows và Dịch vụ Trực tuyến, đồng thời quản lý các đối tác toàn cầu trong bán lẻ, viễn thông, truyền thông và thanh toán.</p>\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Khởi đầu sự nghiệp tại JP Morgan với vai trò Nhà phân tích Tài chính Doanh nghiệp, ông David sau đó tham gia sáng lập EachNet - công ty thương mại điện tử hàng đầu Trung Quốc và đã được eBay mua lại. Ông cũng từng tư vấn chiến lược cho các tập đoàn lớn tại châu Á trong vai trò tại Boston Consulting Group. Hiện nay, ông David còn là thành viên Hội đồng Cố vấn của Endeavor Việt Nam, hỗ trợ các doanh nghiệp tiềm năng tạo tác động lớn tại Việt Nam. Ông tốt nghiệp MBA từ Đại học Harvard và Cử nhân Thương mại từ Đại học New South Wales, với kinh nghiệm quốc tế phong phú đóng góp vào sự phát triển của kinh tế Việt Nam.</p>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <ol class=\"carousel-indicators\">\n                                <li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"0\" data-bs-slide-to=\"0\" class=\"active\"></li>\n                                <li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"1\" data-bs-slide-to=\"1\"></li>\n                                <li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"2\" data-bs-slide-to=\"2\"></li>\n                                <li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"3\" data-bs-slide-to=\"3\"></li>\n                                <li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"4\" data-bs-slide-to=\"4\"></li>\n                                <li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"5\" data-bs-slide-to=\"5\"></li>\n                                <li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"6\" data-bs-slide-to=\"6\"></li>\n                                \n                            </ol>\n                            <a role=\"button\" href class=\"close\" data-dismiss=\"modal\" data-bs-dismiss=\"modal\" aria-label=\"Close\">\n                            </a>\n                            <a class=\"carousel-control-prev carousel-control\" href=\"#lb-{{idGallery}}\" role=\"button\" data-slide=\"prev\" data-bs-slide=\"prev\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-prev\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden\">Previous</span>\n                            </a>\n                            <a class=\"carousel-control-next carousel-control\" href=\"#lb-{{idGallery}}\" role=\"button\" data-slide=\"next\" data-bs-slide=\"next\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden\">Next</span>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
