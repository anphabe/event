        "header_custom": "<meta property=\"og:site_name\" content=\"The Game Changer - HỘI NGHỊ VIỆT NAM XUẤT SẮC 2023 | Anphabe Event\"/>\n<meta property=\"og:rich_attachment\" content=\"true\"/>\n<meta property=\"og:type\" content=\"website\"/>\n<meta name=\"author\" content=\"Anphabe\">\n<meta name=\"title\" property=\"og:title\" content=\"The Game Changer - HỘI NGHỊ VIỆT NAM XUẤT SẮC 2023 | Anphabe Event\">\n<meta name=\"twitter:image:src\" content=\"hhttps://event.anphabe.com/vietnamexcellence/2023/assets/images/share-2023.jpg\">\n<meta property=\"og:image\" content=\"https://event.anphabe.com/assets/images/share-2023.jpg\">\n<meta name=\"description\" property=\"og:description\" content=\"The Game Changer - HỘI NGHỊ VIỆT NAM XUẤT SẮC 2023 | Anphabe Event\">\n<meta name=\"twitter:image:src\" content=\"https://event.anphabe.com/vietnamexcellence/2023/assets/images/share-2023.jpg\">\n<meta property=\"og:image\" content=\"https://event.anphabe.com/vietnamexcellence/2023/assets/images/share-2023.jpg\">",
