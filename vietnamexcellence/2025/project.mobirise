        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".list-group-item": {
              "background-color": "transparent",
              "padding": ".5rem 3.25rem"
            },
            ".plan-body": {
              "padding-bottom": "2rem"
            },
            ".plan-header": {
              "padding-top": "2rem",
              "padding-left": "1rem",
              "padding-right": "1rem"
            },
            ".price": {
              "color": "#01264d"
            },
            ".plan": {
              "word-break": "break-word",
              "background-color": "#ffffff",
              "height": "100%",
              ".list-group-item": {
                "position": "relative",
                "justify-content": "center",
                "border": "0",
                "&::after": {
                  "position": "absolute",
                  "bottom": "1px",
                  "left": "25%",
                  "width": "50%",
                  "height": "1px",
                  "content": "\"\"",
                  "background-color": "rgba(0, 0, 0, 0.1)"
                },
                "&:last-child::after": {
                  "display": "none"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".plan": {
                "margin-bottom": "2rem"
              }
            },
            ".gt-heading.gt-align-center .gt-separate": {
              "justify-content": "center"
            },
            ".gt-separate": {
              "align-items": "center",
              "display": "flex",
              "margin": "3px auto 0",
              "justify-content": "center"
            },
            ".gt-separate:before, .gt-separate:after": {
              "content": "''",
              "display": "block",
              "height": "1px",
              "width": "125px",
              "background": "currentColor",
              "opacity": ".15"
            },
            ".gt-separate svg": {
              "margin": "0 20px",
              "width": "23px",
              "height": "auto",
              "opacity": ".15"
            },
            ".title": {
              "text-align": "center"
            },
            "a.text-primary:link, a.text-primary:hover, a.text-primary:visited, a.text-primary:active": {
              "color": "#353535!important"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".note": {
              "font-size": "0.8rem"
            },
            "@media (max-width: 768px)": {
              ".plan-list.mb-4": {
                "margin-bottom": "0 !important"
              },
              ".price": {
                "font-size": "2.5rem"
              },
              ".gt-separate.mb-3": {
                "margin-bottom": "0 !important"
              },
