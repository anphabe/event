  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Tuyển dụng trên LinkedIn – Săn nhân tài uy tín!",
        "meta_descr": "HR đã sẵn sàng nâng cấp kỹ năng tuyển dụng với LinkedIn?\n Trong thời đại số, LinkedIn không chỉ là nền tảng kết nối người đi làm chuyên nghiệp mà còn là công cụ tuyển dụng mạnh mẽ giúp HR tìm đúng người – giữ đúng chân. Đừng bỏ lỡ LinkedIn Talent Solution Webinar, nơi bạn sẽ khám phá công thức tuyển dụng thông minh để tối ưu hiệu suất và nâng tầm thương hiệu nhà tuyển dụng!",
        "header_custom": "<meta name=\"facebook-domain-verification\" content=\"eskryss5mu3nd6ii839t430680129i\" />\n<meta property=\"og:image\" content=\"https://event.anphabe.com/linkedin-talent-solutions-webinar-2025/assets/images/1882-x-773-landing-page-banner-linkedin-1.jpeg\">",
        "footer_custom": "",
        "html_before": "",
        "socialSharingUrl": ""
      },
      "components": [
