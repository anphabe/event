        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-iconfont": {
              "font-size": "2.5rem",
              "color": "@iconColor"
            },
            ".card-text": {
              "color": "#000000",
              "text-align": "center"
            },
            ".card-title": {
              "color": "#025979",
              "text-align": "center"
            },
            ".md-font": {
              "font-size": "2rem"
            },
            "@media (min-width: 991px)": {
              ".md-font": {
                "font-size": "2.5rem"
              },
              ".card-box": {
                "padding-top": "0!important"
              }
            },
            ".mdf-card": {
              "border-radius": "1rem",
              "cursor": "pointer",
              "backdrop-filter": "blur(20px)",
              "-webkit-backdrop-filter": "blur(20px) !important",
              "transition": "all ease .3s",
              "z-index": "1000",
              "background-color": "rgba(255, 255, 255, 0.562)",
              "border": "1px solid rgba(255, 255, 255, 0.222)"
            },
            ".bgcirle-blur": {
              "background": "transparent!important",
              "position": "relative!important",
              "box-shadow": "0px 0px 5px rgba(0, 0, 0, 0.438) !important",
              "overflow": "hidden!important",
              "border-radius": "1rem!important"
            },
            ".item": {
              "margin": "1rem",
              "z-index": "2",
              "padding": "0!important"
            },
            ".bgcirle-blur::after, .bgcirle-blur::before": {
              "width": "100px",
              "height": "100px",
              "content": "''",
              "position": "absolute",
              "border-radius": "50%",
              "transition": ".5s linear"
            },
            ".bgcirle-blur::after": {
              "top": "-20px",
              "left": "-20px",
              "background-color": "#deeaff",
              "animation": "animFirst 5s linear infinite",
              "z-index": "-1"
            },
            ".bgcirle-blur::before": {
              "background-color": "#deeaff",
              "top": "50%",
              "left": "70%",
              "animation": "animSecond 5s linear infinite",
              "animation-delay": "3s"
            },
            ".bgcirle-blur:hover": {
              "box-shadow": "0px 0px 10px rgba(0, 77, 32, 0.432)"
            },
            ".bgcirle-blur:hover::after": {
              "left": "70%",
              "transform": "scale(1.2)",
              "z-index": "-1"
            },
            ".bgcirle-blur:hover::before": {
              "left": "-10px",
              "transform": "scale(1.2)"
            }
