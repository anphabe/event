          "_name": "header9",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header9\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline name=\"formWidth\" title=\"Form Width\" min=\"4\" max=\"8\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"From Title\" name=\"showFormTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://event.anphabe.com/c/breakfast/assets/images/mbr-3.jpg\" parallax selected>\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#087096\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">           \n        <div class=\"row justify-content-center align-items-top main-container\">            \n            <!--<h3 class=\"mbr-text mbr-fonts-style speaker rs-font aln-top\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-2\"><b>Xây dựng Thương hiệu&nbsp;</b><b>và Tuyển dụng hiệu quả với LinkedIn</b></h3>\n            <p class=\"mbr-text mbr-fonts-style speaker mb-4\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\"><i><b>Tuyển dụng trên LinkedIn - Săn nhân tài uy tín</b></i></p>-->\n\n            <div class=\"col-12 col-md col-lg-6\">                \n                <!--- FORM -->\n                <div class=\"mx-auto mbr-form\">\n                    <form class=\"mbr-form anphabe-lead form-with-styler needs-validation\" novalidate data-form-type=\"anphabe-lead\" name=\"anphabe-lead\" method=\"POST\">\n                    <!-- <input type=\"hidden\" name=\"mail_template\" value=\"eoc2022\"> -->\n                    <a href=\"#register\" style=\"display:none;\"></a>\n                    <a id=\"destination\" href=\"thankyou.html\" style=\"display:none;\"></a>\n                    <input type=\"hidden\" name=\"product_name\" value=\"linkedin\">\n                    <input type=\"hidden\" name=\"utm_source\" id=\"utm_source\" value>\n                    <input type=\"hidden\" name=\"utm_medium\" id=\"utm_medium\" value>\n                    <input type=\"hidden\" name=\"utm_campaign\" id=\"utm_campaign\" value>\n                    <input type=\"hidden\" name=\"utm_term\" value>\n                    <input type=\"hidden\" name=\"utm_content\" value>\n                    <input type=\"hidden\" name=\"landingpage\" value=\"lts-webinar\">\n                    \n                        <div class=\"row\">\n                            <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for filling out the form!</div>\n                            <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">\n                                Oops...! some problem!\n                            </div>\n                        </div>\n                        <div class=\"dragArea row\">\n\n                        <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\">\n                        <h2 mbr-theme-style=\"display-2\" class=\"d-flex justify-content-center mbr-section-form-title\" data-app-selector=\".mbr-section-form-title\" mbr-if=\"showFormTitle\"><b>Đăng ký Webinar tại Anphabe</b></h2>\n                        <i class=\"d-flex align-center justify-content-center align-items-center mdft\">*Vui lòng điền đầy đủ các thông tin dưới đây. Chúng tôi sẽ liên lạc lại trong 24h làm việc</i>\n                        </div>\n                            <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-2\" data-for=\"fullname\">\n                                <input id=\"fullname\" type=\"text\" name=\"fullname\" placeholder=\"Họ và tên bạn\" data-form-field=\"fullname\" required data-required=\"true\" class=\"form-control\" value>\n                                <div class=\"invalid-feedback\">\n                                Vui lòng nhập tên của bạn\n                                </div>\n                            </div>\n                            <div class=\"col-md-6 col-sm-12 form-group mb-2\" data-for=\"email\">\n                                <input id=\"email\" type=\"email\" name=\"email\" data-required=\"true\" required placeholder=\"Email\" data-form-field=\"email\" class=\"form-control\" value>\n                                <div class=\"invalid-feedback\">\n                                Vui lòng nhập email của bạn\n                                </div>\n                            </div>\n                            <div class=\"col-md-6 col-sm-12 form-group mb-2\" data-for=\"phone\">\n                                <input type=\"text\" id=\"phone\" name=\"phone\" data-required=\"true\" required placeholder=\"Số điện thoại\" data-form-field=\"phone\" class=\"form-control\" value>\n                                <div class=\"invalid-feedback\">\n                                Vui lòng nhập số điện thoại liên lạc của bạn\n                                </div>\n                            </div>\n                            <div class=\"col-md-6 col-sm-12 form-group mb-2\" data-for=\"position\">\n                                <input type=\"text\" id=\"position\" name=\"position\" data-required=\"true\" required placeholder=\"Chức vụ\" data-form-field=\"position\" class=\"form-control\" value>\n                                <div class=\"invalid-feedback\">\n                                Vui lòng nhập chức vụ của bạn trong công ty\n                                </div>\n                            </div>\n                            <div class=\"col-md-6 col-sm-12 form-group mb-2\" data-for=\"company-name\">\n                                <input id=\"companyname\" type=\"text\" name=\"companyname\" placeholder=\"Tên công ty\" required data-form-field=\"companyname\" data-required=\"true\" class=\"form-control\" value>\n                                <div class=\"invalid-feedback\">\n                                Vui lòng nhập tên công ty của bạn\n                                </div>\n                            </div>\n\n                            <div class=\"col-12 form-group mb-2\" data-for=\"nhucautuvan\">\n                                <select id=\"nhucautuvan\" name=\"nhucautuvan\" data-form-field=\"nhucautuvan\" required data-required=\"true\" class=\"form-control form-select\" value>\n                                    <option value>Bạn sẽ tham gia Webinar vào ngày:</option>              \n                                    <option value=\"01/04/2025\">01/04/2025 - HR nhóm ngành IT/Công nghệ/Phần mềm</option>\n                                    <option value=\"08/04/2025\">08/04/2025 - HR nhóm ngành khác</option>                      \n                                </select>\n                                <div class=\"invalid-feedback\">\n                                Vui lòng chọn ngày tham gia Webinar\n                                </div>\n                            </div>\n                            \n                            <div mbr-buttons=\"true\" mbr-if=\"showButtons\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-lg-12 col-md-12 col-sm-12 mbr-section-btn d-flex justify-content-center\"><input data-app-placeholder=\"Type Text\" type=\"submit\" class=\"btn btn-danger display-4\" value=\"HOÀN TẤT ĐĂNG KÝ\"></div>                      \n                        </div>\n                    </form>\n                </div>\n            </div> \n            <!--<div class=\"col-12 col-md col-lg-5\">-->\n                \n                <!--<img class=\"w30 mb-3 mt-3\" src=\"file:///C:/mobirise/event/c/breakfast/assets/images/industry-breakfast-2024-10years-b.png\" alt title>-->\n                <!--<h3 class=\"mbr-text mbr-fonts-style speaker \" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-5\"><b style><i>Webinar:</i></b><b><br></b></h3>\n                <h3 class=\"mbr-text mbr-fonts-style speaker mt-4 rs-font aln-top\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-5\"><b style=\"font-weight:900\">XÂY DỰNG THƯƠNG HIỆU VÀ TUYỂN DỤNG HIỆU QUẢ VỚI LINKEDIN<br></b></h3>\n                <p class=\"mbr-text mbr-fonts-style speaker mt-4\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\"><i style><b>Thời gian tham dự:</b></i></p>\n                <p class=\"mbr-text mbr-fonts-style speaker\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">- 01/04/2025: HR nhóm ngành IT/Công nghệ/Phần mềm</p>\n                <p class=\"mbr-text mbr-fonts-style speaker\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">- 08/04/2025: HR nhóm ngành khác</p>\n                <br>\n                \n                \n                \n                <div class=\"item features-without-image active\">\n\n\n                </div>             \n            </div>-->            \n                   \n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
