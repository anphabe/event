          "_name": "features15",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features15\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"2\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Color\" name=\"iconColor\" value=\"#6592e6\" selected condition=\"showIcon\">\n        <select title=\"Columns\" name=\"columns\">\n            <option value=\"3\">4</option>\n            <option value=\"4\" selected>3</option>\n            <option value=\"6\">2</option>\n            <option value=\"12\">1</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <h4 class=\"mbr-section-title mbr-fonts-style mb-5\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\"><b>Điểm nổi bật của sự kiện</b></h4>\n        <div class=\"row justify-content-center\">\n              <div class=\"d-flex align-items-center item features-without-image col-12 col-md-4 active opt1\">\n                  <div class=\"item-wrapper py-4 px-2\">\n                      <div class=\"card-box\">\n                          <h4 class=\"card-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Trải nghiệm những tính năng mới nhất của Recruiter</b></h4>\n                      </div>\n                  </div>\n              </div>\n              <div class=\"d-flex align-items-center item features-without-image col-12 col-md-8 m-0 fxmr odesc1\">\n                  <div class=\"item-wrapper\">\n                      <div class=\"card-box d-flex\">\n                          <h5 class=\"card-text mbr-fonts-style descript\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Đội ngũ chuyên gia của chúng tôi sẽ hướng dẫn bạn trong buổi làm việc thực hành, nơi bạn khám phá và nắm vững các tính năng mới nhất của LinkedIn Recruiter. Bạn sẽ có được những kiến thức thực tế về cách sử dụng Recruiter để xác định, thu hút và tuyển dụng những nhân tài tốt nhất cho doanh nghiệp của bạn.\n                          </h5>\n                      </div>\n                  </div>\n              </div>           \n        </div>\n        <div class=\"row justify-content-center rv\">\n              <div class=\"d-flex align-items-center item features-without-image col-12 col-md-8 fxmr odesc2\">\n                  \n                  <div class=\"item-wrapper\">\n                      <div class=\"card-box d-flex align-items-center\">                      \n                          <h5 class=\" mbr-fonts-style descript\" mbr-theme-style=\"display-7\">Kết nối với các chuyên gia có cùng chí hướng, mở rộng mạng lưới và chia sẻ các phương pháp hay nhất với những khách mời khác. Sự kiện này là cơ hội tuyệt vời để tạo nên những kết nối có ý nghĩa trong ngành tuyển dụng</h5>\n                      </div>\n                  </div>\n              </div> \n              <div class=\"d-flex justify-content-center align-items-center item features-without-image col-12 col-md-4 active opt2 resp-r\">\n                  <div class=\"item-wrapper py-4 px-2\">\n                      <div class=\"card-box\">\n                          <h4 class=\"card-title mbr-fonts-style mb-2 resp-r\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Cơ hội kết nối</b></h4>\n                      </div>\n                  </div>\n              </div>                   \n        </div>\n        <div class=\"row justify-content-center\">\n              <div class=\"d-flex justify-content-center align-items-center item features-without-image col-12 col-md-4 active opt3\">\n                  <div class=\"item-wrapper py-4 px-2\">\n                      <div class=\"card-box\">\n                          <h4 class=\"card-title mbr-fonts-style mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>Truy cập bản Demo độc quyền</b></h4>\n                      </div>\n                  </div>\n              </div>\n              <div class=\"d-flex align-items-center item features-without-image col-12 col-md-8 m-0 fxmr odesc3\">\n                  <div class=\"item-wrapper\">\n                      <div class=\"card-box d-flex align-items-center\">                        \n                          <h5 class=\"card-text mbr-fonts-style descript\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">Phần thưởng đặc biệt khi tham dự Recruitathon là bạn sẽ nhận được quyền truy cập bản demo của LinkedIn Recruiter demo trong ba ngày. Trải nghiệm thực tế này sẽ cho phép bạn khám phá toàn bộ tiềm năng của nền tảng và đưa kỹ năng tuyển dụng của bạn lên một tầm cao mới.</h5>\n                      </div>\n                  </div>\n              </div>           \n        </div>\n         <div class=\"row justify-content-center rv\">\n               \n                                 \n        </div>\n        <div mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove, -mbrBtnRemove\" class=\"mbr-section-btn mt-4\"><a class=\"btn btn-danger\" href=\"index.html#formlead\" data-app-placeholder=\"Type Text\">Đăng ký ngay</a></div>\n\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "features15-4b",
          "_isUserblock": true,
          "_cid": "uF7DuFMilf",
