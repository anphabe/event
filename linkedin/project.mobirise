        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-iconfont": {
              "font-size": "2.5rem",
              "color": "@iconColor"
            },
            ".card-text": {
              "color": "#000000",
              "text-align": "center"
            },
            ".card-title": {
              "color": "#025979",
              "text-align": "center"
            },
            ".md-font": {
              "font-size": "2rem"
            },
            "@media (min-width: 991px)": {
              ".md-font": {
                "font-size": "2.5rem"
              },
              ".card-box": {
                "padding-top": "0!important"
              }
            },
            ".mdf-card": {
              "border-radius": "1rem",
              "cursor": "pointer",
              "backdrop-filter": "blur(20px)",
              "-webkit-backdrop-filter": "blur(20px) !important",
              "transition": "all ease .3s",
              "z-index": "1000",
              "background-color": "rgba(255, 255, 255, 0.562)",
              "border": "1px solid rgba(255, 255, 255, 0.222)"
            },
            ".bgcirle-blur": {
              "background": "transparent!important",
              "position": "relative!important",
              "box-shadow": "0px 0px 5px rgba(0, 0, 0, 0.438) !important",
              "overflow": "hidden!important",
              "border-radius": "1rem!important"
            },
            ".item": {
              "margin": "1rem",
              "z-index": "2",
              "padding": "0!important"
            },
            ".bgcirle-blur::after, .bgcirle-blur::before": {
              "width": "100px",
              "height": "100px",
              "content": "''",
              "position": "absolute",
              "border-radius": "50%",
              "transition": ".5s linear"
            },
            ".bgcirle-blur::after": {
              "top": "-20px",
              "left": "-20px",
              "background-color": "#deeaff",
              "animation": "animFirst 5s linear infinite",
              "z-index": "-1"
            },
            ".bgcirle-blur::before": {
              "background-color": "#deeaff",
              "top": "50%",
              "left": "70%",
              "animation": "animSecond 5s linear infinite",
              "animation-delay": "3s"
            },
            ".bgcirle-blur:hover": {
              "box-shadow": "0px 0px 10px rgba(0, 77, 32, 0.432)"
            },
            ".bgcirle-blur:hover::after": {
              "left": "70%",
              "transform": "scale(1.2)",
              "z-index": "-1"
            },
            ".bgcirle-blur:hover::before": {
              "left": "-10px",
              "transform": "scale(1.2)"
            }
          },
          "_name": "features15",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features15\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Color\" name=\"iconColor\" value=\"#ffffff\" selected condition=\"showIcon\">\n        <select title=\"Columns\" name=\"columns\">\n            <option value=\"3\" selected>4</option>\n            <option value=\"4\">3</option>\n            <option value=\"6\">2</option>\n            <option value=\"12\">1</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#353535\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"item features-without-image mb-5 col-12 col-md-{{columns}}\">\n              <div class=\"bgcirle-blur\">\n                <div class=\"mdf-card\">\n                  <div class=\"item-wrapper d-flex\">\n                      <!--<span mbr-icon class=\"mbr-iconfont m-auto mbri-like\" mbr-if=\"showIcon\" style=\"color: rgb(2, 89, 121); fill: rgb(2, 89, 121);\"></span>-->\n                      <div class=\"card-box py-3\">\n                          <h4 class=\"card-title mbr-fonts-style md-font\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>8 giây</b></h4>\n                          <h5 class=\"card-text mbr-fonts-style px-2\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">Trung bình cho một vị trí đăng tuyển thành công</h5>\n                      </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div class=\"item features-without-image mb-5 col-12 col-md-{{columns}}\">\n              <div class=\"bgcirle-blur\"> \n                <div class=\"mdf-card\"> \n                  <div class=\"item-wrapper  d-flex\">\n                      <!--<span mbr-icon class=\"mbr-iconfont m-auto mbri-star\" mbr-if=\"showIcon\" style=\"color: rgb(2, 89, 121); fill: rgb(2, 89, 121);\"></span>-->\n                      <div class=\"card-box py-3\">\n                          <h4 class=\"card-title mbr-fonts-style md-font\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\"><b>95%</b></h4>\n                          <h5 class=\"card-text mbr-fonts-style px-2\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">Các công ty Fortune 500 sử dụng Linked JobSlot</h5>\n                      </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div class=\"item features-without-image mb-5 col-12 col-md-{{columns}}\">\n              <div class=\"bgcirle-blur\">\n                <div class=\"mdf-card\">  \n                  <div class=\"item-wrapper  d-flex\">\n                      <!--<span mbr-icon class=\"mbr-iconfont m-auto mbri-hearth\" mbr-if=\"showIcon\" style=\"color: rgb(2, 89, 121); fill: rgb(2, 89, 121);\"></span>-->\n                      <div class=\"card-box py-3\">\n                          <h4 class=\"card-title mbr-fonts-style md-font\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                              <b>#1</b></h4>\n                          <h5 class=\"card-text mbr-fonts-style px-2\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".card-text\">Khách hàng đánh giá về chất lượng ứng viên</h5>\n                      </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            \n            \n        </div>\n    </div>\n</section>",
