          "_name": "features13",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features12\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"4\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Button\" name=\"showButton\" checked>\n        <input type=\"range\" inline title=\"Items\" name=\"items\" min=\"1\" max=\"3\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Icon Size\" name=\"iconSize\" min=\"1\" max=\"4\" step=\"1\" value=\"2\">        \n        <input type=\"color\" name=\"iconColor\" title=\"Color\" value=\"#6592e6\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg-2.png\">\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">        \n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-12 schedule-header\">\n                <div class=\"item mbr-flex item-heading\">\n                    <div class=\"icon-box\">\n                        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"29\" height=\"29\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line></svg>\n                    </div>\n                    <div class=\"text-box\">\n                        <h5 class=\"icon-text mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5 date-schedule\" data-app-selector=\".icon-text\"><b>Nội dung chương trình - 19/03/2025</b>&nbsp;</h5>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-md-12 col-lg-12 schedule-wrapper\">\n                <div class=\"item mbr-flex item-border align-items-center\">\n                    <div class=\"time-wrapper\">                                          \n                        <div class=\"mbr-black mbr-fonts-style\" mbr-theme-style=\"display-7 time-slot\">08:30</div>\n                    </div>\n                    <div class=\"text-box\">                        \n                        <h5 class=\"icon-text mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".icon-text\"><b>Kích hoạt tài khoản Demo</b></h5>\n                    </div>\n                </div>\n                <div class=\"item mbr-flex item-border align-items-center\">\n                    <div class=\"time-wrapper\">                                          \n                        <div class=\"mbr-black mbr-fonts-style\" mbr-theme-style=\"display-7 time-slot\">09:00</div>\n                    </div>\n                    <div class=\"text-box\">                        \n                        <h5 class=\"icon-text mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".icon-text\"><b>Giới thiệu chương trình</b></h5>\n                        <!--<div class=\"schedule-speakers mb-4\">\n                                <div class=\"speaker-title\">\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                        <b>Diễn giả</b></p>\n                                </div>\n                                <ul class=\"speaker-list\">\n                                    <li>\n                                        <div class=\"speaker-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/banner-landing-page-1882x773-6mar-1.png\" alt=\"Thanh Nguyễn\">\n                                        </div>\n                                        <div class=\"speaker-detail\">\n                                            <h4 class=\"icon-title mbr-black mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                                Bà <b>THANH NGUYỄN</b><br><i>GĐĐH và Truyền cảm hứng Hạnh Phúc<br> Anphabe</i></h4>\n                                        </div>\n                                    </li>                                   \n                                </ul>\n                            </div>-->\n                    </div>\n                </div>\n                <div class=\"item mbr-flex item-border align-items-center\">\n                    <div class=\"time-wrapper\">                                          \n                        <div class=\"mbr-black mbr-fonts-style\" mbr-theme-style=\"display-7 time-slot\">09:30</div>\n                    </div>\n                    <div class=\"text-box\">                        \n                            <h5 class=\"icon-text mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".icon-text\"><b>Chia sẻ kinh nghiệm tuyển dụng từ khách mời</b></h5>\n                            <!--<div class=\"schedule-speakers mb-4\">\n                                \n                                <div class=\"speaker-title\">\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                        <b>Diễn giả (phiên ngày 23.04)</b></p>\n                                </div>\n                                <ul class=\"speaker-list\">\n                                    <li>\n                                        <div class=\"speaker-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/mr-thnh-nashtech.jpeg\" alt=\"Mr. Nguyễn Thuận Thành\">\n                                        </div>\n                                        <div class=\"speaker-detail\">\n                                            <h4 class=\"icon-title mbr-black mbr-fonts-style\" mbr-theme-style=\"display-7\">Ông&nbsp;<b>NGUYỄN THUẬN THÀNH</b><br><i>Giám đốc nhân sự</i><br><i>NashTech Việt Nam và khối APAC</i></h4>\n                                        </div>\n                                    </li>\n                                    <li>\n                                        <div class=\"speaker-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/mr-khang-nestle.png\" alt=\"Mr. Lê Thành Khang\">\n                                        </div>\n                                        <div class=\"speaker-detail\">\n                                            <h4 class=\"icon-title mbr-black mbr-fonts-style\" mbr-theme-style=\"display-7\">Ông&nbsp;<b>LÊ THÀNH KHANG</b><br><i>Giám đốc Nhân sự </i><br><i>Nestlé Việt Nam</i></h4>\n                                        </div>\n                                    </li>                                  \n                                </ul>\n                                <div class=\"speaker-title\">\n                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                                        <b>Moderator</b></p>\n                                </div>\n                                <ul class=\"speaker-list\">         \n                                    <li>\n                                        <div class=\"speaker-img\">\n                                            <img src=\"@PROJECT_PATH@/assets/images/banner-landing-page-1882x773-6mar-1.png\" alt=\"Thanh Nguyễn\">\n                                        </div>\n                                        <div class=\"speaker-detail\">\n                                            <h4 class=\"icon-title mbr-black mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                                Bà <b>THANH NGUYỄN</b><br><i>GĐĐH và Truyền cảm hứng Hạnh Phúc<br> Anphabe</i></h4>\n                                        </div>\n                                    </li>                                     \n                                </ul>\n                            </div>-->\n                    </div>\n                </div>\n                <div class=\"item mbr-flex item-border align-items-center hideul\">\n                    <div class=\"time-wrapper\">                                          \n                        <div class=\"mbr-black mbr-fonts-style\" mbr-theme-style=\"display-7 time-slot\">10:00</div>\n                    </div>\n                    <div class=\"text-box\">                        \n                        <h5 class=\"icon-text mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".icon-text\"><b>Thực chiến tuyển dụng với LinkedIn Recruiter</b></h5>        \n                    </div>\n                </div>                       \n            </div>\n            <div mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnAdd, -mbrBtnMove, -mbrBtnRemove\" class=\"align-center mbr-section-btn mt-4\"><a class=\"btn btn-danger\" href=\"index.html#formlead\" data-app-placeholder=\"Type Text\">Đăng ký ngay</a></div>\n\n        </div>        \n    </div>\n</section>",
