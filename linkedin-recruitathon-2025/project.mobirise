                "font-size": "28px",
                "text-align": "center"
              }
            },
            ".form-control": {
              "padding": "1rem",
              "line-height": "1.5rem !important",
              "font-family": "'Mulish', sans-serif",
              "font-size": "1rem !important",
              "margin-bottom": "0.5rem",
              "border-radius": "5px",
              "border": "1px solid #d3d3d3!important",
              "box-shadow": "rgba(100, 100, 111, 0.2) 0px 7px 29px 0px"
