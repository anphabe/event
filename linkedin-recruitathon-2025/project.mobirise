            },
            ".card-title, .card-box": {
              "color": "#025979"
            },
            ".icon-text": {
              "text-align": "left"
            },
            "@media (max-width: 768px)": {
              ".btn-mob-none": {
                "display": "none!important"
              },
              ".btn-mob-block": {
                "display": "block!important"
              }
            },
            ".line": {
              "background-color": "rgb(151, 150, 150)",
              "align": "center",
              "height": "1px",
              "margin": "0 auto"
            },
            ".item": {
              "padding": "0.5rem 1rem 0!important",
