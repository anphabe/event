        "meta_descr": "Cập nhật xu hướng nhân sự mới nhất, chia sẻ kinh nghiệm và bài học thực tiễn dành cho CEO & Giám đốc nhân sự",
        "header_custom": "<meta property=\"og:site_name\" content=\"Hội nghị Nơi Làm Việc Tốt Nhất Việt Nam 2025\"/>\n<meta property=\"og:rich_attachment\" content=\"true\"/>\n<meta property=\"og:type\" content=\"website\"/>\n<meta name=\"author\" content=\"Anphabe\">\n<meta name=\"title\" property=\"og:title\" content=\"Hội nghị Nơi Làm Việc Tốt Nhất Việt Nam 2025\">\n<meta name=\"twitter:image:src\" content=\"https://event.anphabe.com/vietnambestplacestowork/2025/assets/images/vnbptw-summit-2025.png\">\n<meta name=\"image\" property=\"og:image\" content=\"https://event.anphabe.com/vietnambestplacestowork/2025/assets/images/vnbptw-summit-2025.png\">\n<meta property=\"og:url\" itemprop=\"url\" content=\"https://event.anphabe.com/vietnambestplacestowork/2025/assets/images/vnbptw-summit-2025.png\"/>\n<meta name=\"description\" property=\"og:description\" content=\"Cập nhật xu hướng nhân sự mới nhất, chia sẻ kinh nghiệm và bài học thực tiễn dành cho CEO & Giám đốc nhân sự\">\n\n<script type=\"text/javascript\">\n      $(function(){\n        $('.de-marquee-list-1').marquee({\n            direction: 'right',\n            duration: 60000,\n            gap: 0,\n            delayBeforeStart: 0,\n            duplicated: true,\n            startVisible: true\n        });\n\n        $('.de-marquee-list-2').marquee({\n            direction: 'left',\n            duration: 60000,\n            gap: 0,\n            delayBeforeStart: 0,\n            duplicated: true,\n            startVisible: true\n        });\n    });\n    </script>",
        "footer_custom": "",
