          "_name": "timeline2",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs timeline2\" group=\"Timelines, Content\" data-bg-video=\"{{bg.type == 'video' &&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mbr-tabs\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse Timeline\" name=\"reverseTimeline\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Dates\" name=\"showDates\" checked>\n        <input type=\"checkbox\" title=\"Images\" name=\"showImages\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <select title=\"Count\" name=\"timelinesAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\">8</option>\n            <option value=\"9\">9</option>\n            <option value=\"10\">10</option>\n            <option value=\"11\" selected>11</option>\n            <option value=\"12\">12</option>\n        </select>\n        <input type=\"color\" name=\"lineColor\" title=\"Color\" value=\"#6592e6\">\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"color\" name=\"tabsColor\" title=\"Color\" value=\"#000000\">\n        <input type=\"color\" name=\"activeColor\" title=\"Active Color\" value=\"#99ca3c\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#3a4c68\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay &&bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                <b>NỘI DUNG SỰ KIỆN</b></h3>            \n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-{{textWidth}}\">\n                <ul class=\"nav nav-tabs mb-4 justify-content-center\" role=\"tablist\">\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item first mbr-fonts-style align-center\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style show active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#noidungsukien_tab0\" data-app-placeholder=\"Type Text\" aria-selected=\"true\"><strong style=\"font-size: 1.8rem\">Phiên sáng</strong><br>[12:00 - 17:00]</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item align-center\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#noidungsukien_tab1\" data-app-placeholder=\"Type Text\" aria-selected=\"true\"><strong style=\"font-size: 1.8rem\">Phiên chiều</strong><br>[17:00 - 21:00]</a></li>\n                    \n                </ul>\n                <div class=\"tab-content\">\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                        <div class=\"timelines-container mt-4\">\n                            <div class=\"row timeline-element separline mb-5\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>12:00 - 13:00</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row align-items-center\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/1.jpg\" alt=\"Đón khách và giao lưu\">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-md-6\">\n                                    <div class=\"timeline-text-content\">\n                                        <h4 class=\"mbr-timeline-title mb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>Đón khách</b> và<b> giao lưu</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                                Tham quan và trải nghiệm khu vực Future Bar &amp; Future Hub</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row timeline-element separline mb-5\" mbr-if=\"timelinesAmount>1\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>13:00 - 13:15</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row align-items-center\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/2.jpg\" alt=\"Khai mạc hội nghị và lễ vinh danh\">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-md-6\">\n                                    <div class=\"timeline-text-content\">\n                                        <h4 class=\"mbr-timeline-title mb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                                            <b>Khai mạc hội nghị </b>và<b> lễ vinh danh</b></h4>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row timeline-element separline mb-5\" mbr-if=\"timelinesAmount>2\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>13:15 - 14:15</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/3.jpg\" alt=\"Mobirise Website Builder\">\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-8 col-md-8\">\n                                                        <div class=\"card-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style m-0 mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                                                <b>Bà THANH NGUYỄN</b></h5>\n                                                            <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                                                GĐĐH &amp; Truyền cảm hứng Hạnh phúc\n                                                                <br>Anphabe<br></h6>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                                <div class=\"row align-items-center mt-2\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/4.jpg\" alt=\"Mobirise Website Builder\">\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-8 col-md-8\">\n                                                        <div class=\"card-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style m-0 mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                                                <b>Bà LƯU BẢO VÂN</b></h5>\n                                                            <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                                                Giám đốc Nghiên cứu\n                                                                <br>Intage Việt Nam&nbsp;<br></h6>\n                                                        </div>\n                                                    </div>