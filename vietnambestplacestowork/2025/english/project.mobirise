 <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>19:00- 19:15</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row align-items-center\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/16.jpg\" alt=\"Lễ vinh danh Chứng nhận Nguồn Nhân Lực Hạnh Phúc® 2025\">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-md-6\">\n                                    <div class=\"timeline-text-content\">\n                                        <h4 class=\"mbr-timeline-title mb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>Recognition of Happiness At Work® 2025 Certifications</b></h4>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row timeline-element separline mb-5\" mbr-if=\"timelinesAmount>9\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>19:15 - 20:15</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row align-items-center\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/15.jpg\" alt=\"Lễ vinh danh 100 Nơi Làm Việc Tốt Nhất Việt Nam® 2025 \">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-md-6\">\n                                    <div class=\"timeline-text-content\">\n                                        <h4 class=\"mbr-timeline-title mb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>Recognition of Top 100 Vietnam Best Places To Work® 2025</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">\n                                                Large Enterprises Category\n                                            </p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row timeline-element separline mb-5\" mbr-if=\"timelinesAmount>10\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>20:15 - 21:00</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row align-items-center\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/13.jpg\" alt=\"Mobirise Website Builder\">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-md-6\">\n                                    <div class=\"timeline-text-content\">\n                                        <h4 class=\"mbr-timeline-title mb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>Group photos <span style=\"font-family: Arial, sans-serif;\">&amp;</span> closing</b></h4>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        \n        <div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-danger\" href=\"https://event-register.anphabe.com/register.en.html\" data-app-placeholder=\"Type Text\">REGISTER NOW</a></div>\n    </div>\n</section>",
          "_cid": "uVIiPVxVil",
          "_anchor": "agenda",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when not (@spacing)": {
              ".row": {
                "margin-left": "0",
                "margin-right": "0"
              },
              ".item": {
                "padding-left": "0",
                "padding-right": "0"
              }
            },
            "& when (@spacing)": {
              ".item": {
                "padding-bottom": "2rem"
              }
            },
            ".item-wrapper": {
              "& when (@autoSize)": {
                "& when not (@showItemSubtitle)": {
                  "height": "100%"
                },
                "& when (@showItemSubtitle)": {
                  "height": "(@imageHeight * 100px)"
                },
                "img": {
                  "height": "100%",
                  "object-fit": "cover"
                }
              },
              "position": "relative",
              ".icon-wrapper": {
                "pointer-events": "none",
                "position": "absolute",
                "width": "60px",
                "height": "60px",
                "font-size": "22px",
                "left": "50%",
                "top": "50%",
                "display": "flex",
                "align-items": "center",
                "justify-content": "center",
                "border": "2px solid #ffffff",
                "border-radius": "50%",
                "opacity": "0",
                "color": "#ffffff",
                "transform": "translateX(-50%) translateY(-50%)",
                "background-color": "#1b1b1b",
                "transition": "0.2s"
              },
              "&:hover": {
                ".icon-wrapper": {
                  "opacity": "0.7"
                }
              }
            },
            ".carousel-control, .close": {
              "background": "#1b1b1b"
            },
            ".carousel-control-prev": {
              "margin-left": "2.5rem",
              "span": {
                "margin-right": "5px"
              }
            },
            ".carousel-control-next": {
              "margin-right": "2.5rem",
              "span": {
                "margin-left": "5px"
              }
            },
            ".close": {
              "position": "fixed",
              "opacity": "0.5",
              "font-size": "22px",
              "font-weight": "300",
              "width": "60px",
              "height": "60px",
              "border-radius": "50%",
              "color": "#fff",
              "top": "2.5rem",
              "right": "2.5rem",
              "border": "2px solid #fff",
              "text-shadow": "none",
              "z-index": "5",
              "transition": "opacity 0.3s ease",
              "font-family": "'Moririse2'",
              "align-items": "center",
              "justify-content": "center",
              "display": "flex",
              "&::before": {
                "content": "'\\e91a'"
              },
              "&:hover": {
                "opacity": "1",
                "background": "#000",
                "color": "#fff"
              }
            },
            ".carousel-control": {
              "display": "flex",
              "top": "50%",
              "width": "60px",
              "height": "60px",
              "margin-top": "-1.5rem",
              "font-size": "22px",
              "background-color": "rgba(0, 0, 0, 0.5)",
              "border": "2px solid #fff",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "&.carousel-control-prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.carousel-control-next": {
                "right": "0",
                "margin-right": "2.5rem"
              },
              "@media (max-width: 767px)": {
                "top": "auto",
                "bottom": "1rem"
              }
            },
            ".carousel-indicators": {
              "position": "absolute",
              "bottom": "0",
              "margin-bottom": "3px",
              "li": {
                "max-width": "15px",
                "height": "15px",
                "width": "15px",
                "max-height": "15px",
                "margin": "3px",
                "background-color": "rgba(0, 0, 0, 0.5)",
                "border": "2px solid #fff",
                "border-radius": "50%",
                "opacity": "0.5",
                "transition": "all 0.3s",
                "&.active, &:hover": {
                  "opacity": "0.9"
                },
                "&::after, &::before": {
                  "content": "none"
                }
              },
              "&.ie-fix": {
                "left": "50%",
                "display": "block",
                "width": "60%",
                "margin-left": "-30%",
                "text-align": "center"
              },
              "@media (max-width: 768px)": {
                "display": "none !important"
              },
              "@media (max-width: 991px)": {
                "margin-bottom": "3.625rem !important",
                "padding-left": "2.5rem",
                "padding-right": "2.5rem"
              },
              "@media (max-width: 767px)": {
                "display": "none"
              }
            },
            ".carousel-inner": {
              "display": "flex",
              "align-items": "center",
              "margin": "0 auto",
              "width": "50%"
            },
            ".carousel-inner > .active": {
              "display": "block"
            },
            ".carousel-control.left": {
              "left": "0",
              "margin-left": "2.5rem"
            },
            ".carousel-control.right": {
              "right": "0",
              "margin-right": "2.5rem"
            },
            ".carousel-control:hover": {
              "background": "#1b1b1b",
              "color": "#fff",
              "opacity": "1"
            },
            "@media (max-width: 768px)": {
              ".carousel-control, .carousel-indicators, .modal .close": {
                "position": "fixed"
              },
              ".carousel-inner": {
                "width": "100%"
              },
              ".text-wrapper": {
                "margin-top": "2rem"
              }
            },
            "@media (max-width: 767px)": {
              ".mbr-slider .carousel-control": {
                "top": "auto",
                "bottom": "20px"
              },
              ".mbr-slider > .container .carousel-control": {
                "margin-bottom": "0"
              }
            },
            ".carousel-indicators .active, .carousel-indicators li": {
              "width": "7px",
              "height": "7px",
              "margin": "3px",
              "background": "#000000",
              "opacity": "0.5",
              "border": "4px solid #000000"
            },
            ".carousel-indicators .active": {
              "background": "#fff"
            },
            ".carousel-indicators li": {
              "max-width": "15px",
              "max-height": "15px",
              "border-radius": "50%"
            },
            ".modal": {
              "padding-left": "0 !important",
              "position": "fixed",
              "overflow": "hidden",
              "padding-right": "0 !important"
            },
            ".modal-dialog": {
              "margin": "0 auto",
              "max-width": "100%",
              "padding-left": "1rem",
              "padding-right": "1rem"
            },
            ".modal-content": {
              "border-radius": "0",
              "border": "none"
            },
            ".modal-body": {
              "padding": "0",
              "display": "flex",
              "align-items": "center",
              "img": {
                "width": "100%",
                "object-fit": "contain",
                "max-height": "~\"calc(100vh - 1.75rem)\""
              }
            },
            ".modal-backdrop.in": {
              "opacity": "0.8"
            },
            ".modal.fade .modal-dialog": {
              "transition": "margin-top 0.3s ease-out"
            },
            ".modal.fade .modal-dialog, .modal.in .modal-dialog": {
              "transform": "none"
            },
            ".mbr-gallery .item-wrapper": {
              "cursor": "pointer"
            },
            ".card-title, .social-row": {
              "color": "#3a4c68"
            },
            ".mbr-role, .social-row": {
              "color": "#3a4c68"
            },
            "H3": {
              "color": "#3a4c68"
            },
            ".carousel": {
              "background": "linear-gradient(134deg, rgba(207, 217, 223, 1) 0%, rgba(224, 230, 236, 1) 25%, rgba(224, 230, 236, 1) 62%, rgba(127, 145, 160, 1) 100%)",
              "width": "100%"
            },
            ".text-txt": {
              "height": "200px",
              "overflow": "auto"
            },
            ".fs-30": {
              "font-size": "28px"
            },
            ".name": {
              "text-transform": "uppercase!important",
              "font-weight": "bold"
            },
            "ul": {
              "padding-left": "1rem"
            }
          },
          "_name": "gallery5",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery5 mbr-gallery\" group=\"Sliders & Galleries\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\">\n    <mbr-parameters>\n        <input type=\"id\" name=\"idGallery\">\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <select title=\"Columns\" name=\"cardsWidth\">\n            <option value=\"12\">1</option>\n            <option value=\"6\">2</option>\n            <option value=\"4\" selected>3</option>\n            <option value=\"3\">4</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked>\n        <input type=\"checkbox\" title=\"Role\" name=\"showRole\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDescription\">\n        <header>Images</header>\n        <input type=\"checkbox\" title=\"Auto Size\" name=\"autoSize\">\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"autoSize && showItemSubtitle\">\n        <input type=\"checkbox\" title=\"Spacing\" name=\"spacing\" checked>\n        <input type=\"checkbox\" title=\"Caption\" name=\"showItemSubtitle\" checked>\n        <header>Popup Slider</header>\n        <input type=\"checkbox\" title=\"Fade Effect\" name=\"fade\">\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"3\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#cfd9df\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <header condition=\"bg.type!=='color'\">Overlay</header>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#fafafa\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth,\n                    'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h3 class=\"mbr-section-title mbr-fonts-style align-center m-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>FEATURED SPEAKERS</b></h3>\n        </div>\n        <div class=\"row mbr-gallery mt-4\">\n            <div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image active\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker1.png\" alt=\"Mobirise Website Builder\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"0\" data-bs-slide-to=\"0\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">\n                        Ms. <span class=\"name\">THANH NGUYEN</span></h5>\n                    <h6 class=\"mbr-role mbr-fonts-style align-center mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>Chief Happiness Officer</b><br>\n                        <b>Anphabe</b></h6>\n                </div>\n            </div>\n            <div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker2.png\" alt=\"Mobirise Website Builder\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">Ms. <span class=\"name\">LUU BAO VAN</span></h5>\n                    <h6 class=\"mbr-role mbr-fonts-style align-center mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>Research Director</b><br><b>Intage Vietnam</b></h6>\n                </div>\n            </div><div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker4.png\" alt=\"Mobirise Website Builder\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">Ms. <span style=\"text-transform: uppercase;\"><b>Rachele Focardi</b></span></h5>\n                    <h6 class=\"mbr-role mbr-fonts-style align-center mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>Global Expert &amp; Keynote Speaker; LinkedIn Top Voice; Top 6 Most Influential Women in the New World of Work; Member of MENSA International (The largest and oldest high-IQ society in the world)</b></h6>\n                </div>\n            </div><div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker6.png\" alt=\"Geovanne Bertonha\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">Mr. <span style=\"text-transform: uppercase;\"><b>Geovanne Bertonha</b></span></h5>\n                    <h6 class=\"mbr-role mbr-fonts-style align-center mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>Chief Executive Officer <br>MTI Technology</b></h6>\n                </div>\n            </div><div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker8.png\" alt=\"Ms. TRINH MAI PHUONG\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"4\" data-bs-slide-to=\"4\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">Ms. <span style=\"text-transform: uppercase;\"><b>TRINH MAI PHUONG</b></span></h5>\n                    <h6 class=\"mbr-role mbr-fonts-style align-center mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>Personal Care HR Lead, Unilever Greater Asia \n</b><div><b>Vietnam Head of HR, Unilever Vietnam</b></div></h6>\n                </div>\n            </div><div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker9.png\" alt=\"Mr. NGUYEN VIET HA\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"5\" data-bs-slide-to=\"5\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">Mr. <span style=\"text-transform: uppercase;\"><b>NGUYEN VIET HA</b></span></h5>\n                    <h6 class=\"mbr-role mbr-fonts-style align-center mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>General Manager\n</b><div><b>PepsiCo Foods Vietnam</b></div></h6>\n                </div>\n            </div><div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker7.png\" alt=\"Mr. NGUYEN VIET HA\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"6\" data-bs-slide-to=\"6\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">Ms. <span style=\"text-transform: uppercase;\"><b>CAP THI MINH TRANG</b></span></h5>\n                    <h6 class=\"mbr-role mbr-fonts-style align-center mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>HR Director, Schneider Electric Vietnam &amp; Cambodia  \n</b><div><b>Schneider Electric</b></div></h6>\n                </div>\n            </div><div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker10.png\" alt=\"Mr. NGUYEN TRUONG HAI\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"7\" data-bs-slide-to=\"7\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">Mr. <span style=\"text-transform: uppercase;\"><b>NGUYEN TRUONG HAI</b></span></h5>\n                    <h6 class=\"mbr-role mbr-fonts-style align-center mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>CEO</b><div><b>Saint-Gobain Vietnam</b></div></h6>\n                </div>\n            </div><div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker12.png\" alt=\"Mrs. NGUYEN THI NGOC HUE\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"8\" data-bs-slide-to=\"8\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">Mr. <span style=\"text-transform: uppercase;\"><b>LE THANH KHANG</b></span></h5>\n                    <h6 class=\"mbr-role mbr-fonts-style align-center mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>Head of HR</b><br><div><b>Nestlé Vietnam</b></div></h6>\n                </div>\n            </div><div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker-13.png\" alt=\"Ms. TRAN THI TUYET NHUNG\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"9\" data-bs-slide-to=\"9\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">Ms.&nbsp;<span style=\"text-transform: uppercase;\"><b>TRAN THI TUYET NHUNG</b></span></h5>\n                    <h6 class=\"mbr-role mbr-fonts-style align-center mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>Human Resources Director</b><br><div><b>AstraZeneca Vietnam</b></div></h6>\n                </div>\n            </div><div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker11-1.png\" alt=\"Ms. TRAN THI TUYET NHUNG\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"10\" data-bs-slide-to=\"10\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\">Ms.&nbsp;<span style=\"text-transform: uppercase;\"><b>DO THUY DUONG</b></span></h5>\n                    <h6 class=\"mbr-role mbr-fonts-style align-center mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\"><b>Founder &amp; CEO</b><br><div><b>The MAP</b></div></h6>\n                </div>\n            </div><div class=\"col-12 col-md-6 col-lg-{{cardsWidth}} item gallery-image\">\n                <div class=\"item-wrapper\" data-toggle=\"modal\" data-bs-toggle=\"modal\" data-target=\"#{{idGallery}}-modal\" data-bs-target=\"#{{idGallery}}-modal\">\n                    <img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/speaker-e.png\" alt=\"Updating\" data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"11\" data-bs-slide-to=\"11\">\n                </div>\n                <div class=\"content-wrap\">\n                    <h5 class=\"mbr-section-title card-title mbr-fonts-style align-center mt-4 mb-2\" mbr-theme-style=\"display-5\" mbr-if=\"showName\" data-app-selector=\".card-title, .social-row\"><b>Updating</b></h5>\n                </div>\n            </div>\n                \n        </div>\n\n        <div class=\"modal mbr-slider\" id=\"{{idGallery}}-modal\" tabindex=\"-1\" role=\"dialog\" aria-hidden=\"true\">\n            <div class=\"modal-dialog\" role=\"document\">\n                <div class=\"modal-content\">\n                    <div class=\"modal-body\">\n                        <div id=\"lb-{{idGallery}}\" class=\"carousel slide\" mbr-class=\"{'carousel-fade': fade}\" data-ride=\"{{autoplay ? 'carousel' : false}}\" data-bs-ride=\"{{autoplay ? 'carousel' : false}}\" data-interval=\"{{interval*1000}}\" data-bs-interval=\"{{interval*1000}}\">                        \n                            <div class=\"carousel-inner\">\n                                <div class=\"carousel-item active\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker1.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style fs-30\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                Ms. <span class=\"name\">THANH NGUYEN<span></span></span></h3>\n                                                <h6 class=\"mbr-role mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                                    <b>Chief Happiness Officer</b><br>\n                                                    <b>Anphabe</b></h6>\n                                                <div class=\"text-txt\">\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Ms. Thanh Nguyen is Chief Happiness Officer at Anphabe - the pioneer in Employer Branding and Happiness at Work solutions in Vietnam. With the mission “Building a happy Vietnamese workforce,” in August 2017 she became the first Vietnamese to receive the international “Contribution to the HR Community” award by HRD Asia Congress.</p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Before founding Anphabe, she was Regional Senior Brand Director for Asia, Africa and the Middle East at Unilever, and later Founder &amp; CEO of an HR services company under Navigos Group.</p>\n                                                </div>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n                                </div>\n                                <div class=\"carousel-item\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker2.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style fs-30\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                Ms. <span class=\"name\">LUU BAO VAN</span></h3>\n                                                <h6 class=\"mbr-role mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                                    <b>Research Director</b><br>\n                                                    <b>Intage Vietnam</b></h6>\n                                                <div class=\"text-txt\">\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Van holds a Master’s in Marketing, Sales and Services (Sorbonne University in partnership with IAE Paris &amp; ESCP-EAP). She is a key leader at Intage - Japan’s No.1 market research firm and a top 10 global player. </p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">With 10 years of qualitative and quantitative experience, Van is a familiar face to multinational and Vietnamese companies in market measurement, consumer trend analysis, and strategy planning.</p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Beyond research, she frequently speaks on consumer trends and tech-enabled research solutions, and contributes to training and teaching in the research field.</p>\n                                                </div>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n\n\n                                    \n                                </div><div class=\"carousel-item\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker4.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style fs-30\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                Ms. <span class=\"name\">Rachele Focardi</span></h3>\n                                                <h6 class=\"mbr-role mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                                    <b>Global Expert &amp; Keynote Speaker; LinkedIn Top Voice; Top 6 Most Influential Women in the New World of Work; Member of MENSA International (The largest and oldest high-IQ society in the world)</b></h6>\n                                                <div class=\"text-txt\">\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Rachele Focardi is a global thought leader, bestselling author, and TEDx speaker dedicated to helping organizations build meaningful collaboration across generations. She is the Founder &amp; CEO of XYZ@Work and Chair of the Multigenerational Workforce Committee at the ASEAN Human Development Organization (AHDO). She is also a renowned speaker on global talent and generational trends, regularly invited to deliver keynotes at top conferences and leadership summits around the world. </p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">For more than two decades, Rachele has advised global corporations - including the majority of Fortune 100 companies, leading organizations across APAC and government bodies - helping them address future talent needs and maximize their strengths as employers to lay the foundation for successful Employer Branding and Talent Strategies. </p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Recognized among the Top 6 Most Influential Women in the New World of Work and recipient of the “Pioneer” Award for advancing generational equity, Rachele is also a Global LinkedIn Top Voice and proud Member of MENSA International - the world’s largest and oldest high-IQ society. </p>\n                                                </div>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n\n\n                                    \n                                </div><div class=\"carousel-item\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker6.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style fs-30\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                Mr. <span class=\"name\">GEOVANNE BERTONHA</span></h3>\n                                                <h6 class=\"mbr-role mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                                    <b>Chief Executive Officer<br>MTI Technology</b></h6>\n                                                <div class=\"text-txt\">\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Geovanne Bertonha is a pioneering technology leader and currently serves as the CEO of MTI Technology. With many years of experience in designing and leading digital transformation across Asia, he combines the power of Lean and Artificial Intelligence (AI) to optimize operations and drive innovation within organizations. </p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Under his leadership, MTI Technology has built a strong team of technology engineers, applying Agile and advanced technologies to deliver comprehensive solutions — from software development to specialized Digital Transformation projects. </p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Geovanne believes that people are at the heart of every technological advancement. He promotes a culture of continuous learning, encourages creativity and collaboration, and fosters a flexible work environment where ideas are nurtured and brought to life. </p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">With an inspiring leadership style, he focuses not only on business performance but also on creating long-term impact, helping enterprises achieve sustainable growth and strengthen their position in the digital era. </p>\n                                                </div>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n\n\n                                    \n                                </div><div class=\"carousel-item\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker8.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style fs-30\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                Ms. <span class=\"name\">TRINH MAI PHUONG</span></h3>\n                                                <h6 class=\"mbr-role mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                                    <b>Personal Care HR Lead, Unilever Greater Asia \nVietnam Head of HR, Unilever Vietnam</b></h6>\n                                                <div class=\"text-txt\">\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">After pursuing a Master’s Degree in Educational Management in Australia, Ms. Trinh Mai Phuong came back to Vietnam and accelerated her career in Human Resources Management. She has 18 years of deep experience in both strategic, expertise and generalist roles for large FMCG companies, in diverse areas of expertise including: learning, talent and leadership development, HR business partnering, strategic HR planning and management.</p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Having a strong passion for lifelong learning, she strives for continuously innovating HR practices to enable the workforce to adopt agile learning, get prepared for the future and create more values to self and others. She has lived in Ukraine, Russia, Australia, Indonesia and can speak a number of languages. She is a strong advocate for diversity, inclusiveness and agility in the workplace.</p>\n                                                </div>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n\n\n                                    \n                                </div><div class=\"carousel-item\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker9.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style fs-30\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                Mr. <span class=\"name\">NGUYEN VIET HA</span></h3>\n                                                <h6 class=\"mbr-role mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                                    <b>General Manager<br>PepsiCo Foods Vietnam</b></h6>\n                                                <div class=\"text-txt\">\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Nguyen Viet Ha has more than 20 years of working experience holding senior commercial leadership roles in FMCG industry and now holding as General Manager of PepsiCo Foods Vietnam.</p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">He demonstrated remarkable leadership by guiding his team through a series of ongoing transformations, ultimately achieving success even during the challenges posed by the Covid-19 pandemic. Under his stewardship, Lays has ascended to become the premier snack brand in Vietnam. Beyond his impressive business achievements, Ha has been a staunch supporter of PepsiCo Foods Vietnam's Employer Branding Strategy since 2020. He has played a pivotal role in cultivating the DARE TO WIN &amp; CARE TO WIN culture within the core of PepsiCo, truly embodying the spirit of a captain leading his team to victory.</p>\n                                                </div>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n\n\n                                    \n                                </div><div class=\"carousel-item\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker7.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style fs-30\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                Ms. <span class=\"name\">CAP THI MINH TRANG</span></h3>\n                                                <h6 class=\"mbr-role mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                                    <b>HR Director, Schneider Electric Vietnam &amp; Cambodia Schneider Electric</b></h6>\n                                                <div class=\"text-txt\">\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Ms. Cap Thi Minh Trang currently holds the position of HR Director, Schneider Electric Vietnam &amp; Cambodia. With 20 years of working experiences, she has always played critical Human Resources Management roles in various types of organizations including local Human Resources Services companies and Multinational corporations such as Deloitte, America Indochina Management, British American Tobacco, Abbott Nutrition International &amp; Schneider Electric. At Schneider Electric, Trang is a member of the Vietnam Cluster Leadership Team as well as Regional HR Leadership Team in East Asia and serves as the primary strategic partner to the Business leaders by developing Human Resources strategies, organization needs assessments and resulting Human Resources solutions.</p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Besides her HR professional work, Trang is also an owner of Capdesign, her own fashion brand targeting professional working women. This expertise has made her become a professional lecturer on Dress Code at John Robert Powers Vietnam since 2016.</p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Interestingly, Trang was born in a family of musicians and became a professional pianist since her early age. This actually makes her profile become very unique and the values that she brings to her stakeholders, colleagues and clients are also very exciting and diverse.</p>\n                                                </div>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n\n\n                                    \n                                </div><div class=\"carousel-item\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker10.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style fs-30\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                Mr. <span class=\"name\">NGUYEN TRUONG HAI</span></h3>\n                                                <h6 class=\"mbr-role mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                                    <b>HR Director, Schneider Electric Vietnam &amp; Cambodia Schneider Electric</b></h6>\n                                                <div class=\"text-txt\">\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Mr. Nguyen Truong Hai has been the CEO of Saint-Gobain Vietnam since 2021, pioneering the company’s growth as a leading provider of sustainable building solutions with nearly 15 member brands. Amid the Covid-19 pandemic, he and his team executed a fast and agile response strategy that delivered significant achievements, ensuring business continuity for the company, its partners, and customers.</p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">With nearly 15 years of dedication, he has shaped innovation-driven strategies, built high-performing teams, and fostered a collaborative and happy workplace. Holding an MBA and with prior management experience at Nestlé, Intel, and NEC, he brings a strong foundation of international expertise. Mr. Hai also serves as Vice Chairman of the Ho Chi Minh City Green Business Association and the Ho Chi Minh City Construction &amp; Building Materials Association, where he champions sustainable development, environmental protection, and the adoption of green solutions in business practices.</p>\n                                                </div>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n\n\n                                    \n                                </div><div class=\"carousel-item\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker12.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style fs-30\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                Mr. <span class=\"name\">LE THANH KHANG</span></h3>\n                                                <h6 class=\"mbr-role mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                                    <b>Head of HR<br>Nestlé Vietnam</b></h6>\n                                                <div class=\"text-txt\">\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">More than 17 years of experience in Human Resources and Business Intelligence, with diverse perspectives and working experience in the Nestlé Indochina Region (Vietnam, Thailand, Myanmar, Laos, Cambodia). Khang has previously held Regional HR role in Switzerland (Nestlé Headquarter) and has led multiple organization development projects across various countries in Asia.</p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Khang's passion lies in people development, youth development, organizational capabilities, and driving organizational transformation that aligns with the strategic objectives and growth of the business.</p>\n                                                </div>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n\n\n                                    \n                                </div><div class=\"carousel-item\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker-13.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style fs-30\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                Ms. <span class=\"name\">Tran Thi Tuyet Nhung</span></h3>\n                                                <h6 class=\"mbr-role mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                                    <b>Human Resources Director<br>AstraZeneca Vietnam</b></h6>\n                                                <div class=\"text-txt\">\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Tran Thi Tuyet Nhung is the Human Resources Director for AstraZeneca in Vietnam, a global science-led biopharmaceutical company operating in over 100 countries. With over two decades of experience across leading multinational organizations, including Sanofi-Aventis, Lafarge, Coats, Abbott, AstraZeneca Asia Frontier Markets Nhung brings deep expertise in HR leadership, organizational transformation, and talent strategy.</p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Her career spans diverse sectors from healthcare to manufacturing and commercial operations, with a strong track record in leading in change, organizational design, M&A, and employee engagement. Nhung has also led talent development initiatives across Asia, shaping future-ready workforces.</p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Driven by a passion for nurturing young talent, Nhung sees people as a catalyst for business growth and innovation. She is committed to building inclusive, high-performing cultures and empowering the next generation of leaders to thrive in a rapidly evolving world of work.</p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Outside of work, Nhung finds inspiration in Triathlon (swim, bike, run) & Trail running, an embodiment of her belief in resilience, continuous learning, and pushing boundaries.</p>\n                                                </div>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n\n\n                                    \n                                </div><div class=\"carousel-item\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker11-1.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style fs-30\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                Ms. <span class=\"name\">DO THUY DUONG</span></h3>\n                                                <h6 class=\"mbr-role mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showRole\" data-app-selector=\".mbr-role, .social-row\">\n                                                    <b>Founder & CEO<br>The MAP</b></h6>\n                                                <div class=\"text-txt\">\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">A leading Strategic Partner for enterprises in the fields of human development, building high-performing teams, and organizational culture, with more than 22 years of experience in training, consulting, and providing strategic advisory services for banks, major corporations, economic groups, and social organizations both in Vietnam and abroad. </p>\n                                                    <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">KEY EXPERIENCE </p>\n                                                    <ul class=\"list mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article>\n                                                        <li>Director of the Culture Training Center, Vingroup (2023) </li>\n                                                        <li>Director of Talent and Culture Development, VinFast (2022) </li>\n                                                        <li>Founder &amp; CEO of TalentPool since 2008 </li>\n                                                        <li>Vice President of Hanoi Association for Women Entrepreneurs (HNEW) </li>\n                                                        <li>Member of the Hanoi People’s Council (2016–2021) </li>\n                                                        <li>TED Talk speaker, frequent guest on major TV and radio programs such as: Cất Cánh VTV1, VTV3, VOV, Cà phê sáng, Host of the program 'Người Được Chọn' </li>\n                                                </ul></div>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n\n\n                                    \n                                </div><div class=\"carousel-item\">\n                                    <div class=\"row align-items-center\">                                       \n                                        <div class=\"col-12 col-md-6\">\n                                            <div class=\"image-wrapper\">\n                                                <img class=\"d-block w-100\" src=\"@PROJECT_PATH@/assets/images/speaker.png\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                        </div>\n                                        <div class=\"col-12 col-md-4\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                                            <div class=\"text-wrapper align-left\">\n                                                <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\">\n                                                <b>UPDATING</b></h3>\n                                                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Updating</p>\n                                            </div>\n                                        </div>                                        \n                                    </div>\n\n\n                                    \n                                </div>\n                            </div>\n                            <ol class=\"carousel-indicators\">\n                                <li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"0\" data-bs-slide-to=\"0\" class=\"active\"></li><li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"1\" data-bs-slide-to=\"1\" class></li><li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"2\" data-bs-slide-to=\"2\" class></li><li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"3\" data-bs-slide-to=\"3\" class></li><li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"4\" data-bs-slide-to=\"4\" class></li><li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"5\" data-bs-slide-to=\"5\" class></li><li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"6\" data-bs-slide-to=\"6\" class></li><li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"7\" data-bs-slide-to=\"7\" class></li><li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"8\" data-bs-slide-to=\"8\" class></li><li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"9\" data-bs-slide-to=\"9\" class></li><li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"10\" data-bs-slide-to=\"10\" class></li><li data-target=\"#lb-{{idGallery}}\" data-bs-target=\"#lb-{{idGallery}}\" data-slide-to=\"11\" data-bs-slide-to=\"11\" class></li>\n                                \n                                \n                                \n                            </ol>\n                            <a role=\"button\" href class=\"close\" data-dismiss=\"modal\" data-bs-dismiss=\"modal\" aria-label=\"Close\">\n                            </a>\n                            <a class=\"carousel-control-prev carousel-control\" href=\"#lb-{{idGallery}}\" role=\"button\" data-slide=\"prev\" data-bs-slide=\"prev\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-prev\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden\">Previous</span>\n                            </a>\n                            <a class=\"carousel-control-next carousel-control\" href=\"#lb-{{idGallery}}\" role=\"button\" data-slide=\"next\" data-bs-slide=\"next\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next\" aria-hidden=\"true\"></span>\n                                <span class=\"sr-only visually-hidden\">Next</span>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uVIDqktajo",
          "_anchor": "speaker",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "0",
            "padding-bottom": "0",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "img, .item-img": {
              "& when (@autoSize)": {
                "height": "100%",
                "object-fit": "cover",
                "& when (@showCardTitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showCardSubtitle)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showText)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                },
                "& when (@showButtons)": {
                  "height": "(@imageHeight * 100px)",
                  "object-fit": "cover"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item-wrapper": {
              "position": "relative"
            },
            ".slide-content": {
              "position": "relative",
              "border-radius": "4px",
              "background": "@cardsBg",
              "height": "100%",
              "display": "flex",
              "overflow": "hidden",
              "flex-flow": "column nowrap",
              "@media (min-width: 992px)": {
                "& when (@showButtons)": {
                  ".item-content": {
                    "padding": "2rem 2rem 0"
                  },
                  ".item-footer": {
                    "padding": "0 2rem 2rem"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "2rem"
                  }
                }
              },
              "@media (max-width: 991px)": {
                "& when (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem 1rem 0"
                  },
                  ".item-footer": {
                    "padding": "0 1rem 1rem"
                  }
                },
                "& when not (@showButtons)": {
                  ".item-content": {
                    "padding": "1rem"
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important"
            },
            ".mbr-section-title": {
              "color": "#232323"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center"
            },
            ".item-title": {
              "text-align": "center"
            },
            ".item-subtitle": {
              "text-align": "center",
              "color": "#232323"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "410px",
              "max-width": "410px",
              "@media (max-width: 768px)": {
                "min-width": "70%",
                "max-width": "initial",
                "margin-left": "1rem !important",
                "margin-right": "1rem !important"
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "50%",
              "width": "60px",
              "height": "60px",
              "margin-top": "-1.5rem",
              "font-size": "22px",
              "background-color": "rgba(0, 0, 0, 0.5)",
              "color": "#fff",
              "border": "2px solid #fff",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "background": "#000",
                "color": "rgba(255, 255, 255, 0.5)"
              },
              "&.embla__button--prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              },
              "@media (max-width: 767px)": {
                "top": "auto"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".marqueen-container": {
              "transform": "rotateZ(2deg)",
              "background-color": "#778a99"
            },
            "@keyframes fadeInLeft": {
              "from": {
                "opacity": "0",
                "-webkit-transform": "translate3d(-10%, 0, 0)",
                "transform": "translateX(-100%)"
              },
              "to": {
                "opacity": "1",
                "-webkit-transform": "none",
                "transform": "translateX(0)"
              }
            },
            "@keyframes marqueeAnimation-left": {
              "0%": {
                "transform": "translateX(-3345.64px)"
              },
              "100%": {
                "transform": "translateX(0)"
              }
            },
            ".fadeInLeft": {
              "animation-name": "fadeInLeft",
              "animation-duration": "3s"
            },
            ".marqueeAnimationLeft": {
              "animation-duration": "3s",
              "width": "100000px",
              "animation": "30s linear 0s infinite",
              "animation-name": "marqueeAnimation-left"
            },
            ".marqueen-container-dark": {
              "background-color": "#3a4c68"
            },
            "@keyframes fadeInRight": {
              "from": {
                "opacity": "0",
                "-webkit-transform": "translate3d(10%, 0, 0)",
                "transform": "translateX(100%)"
              },
              "to": {
                "opacity": "1",
                "-webkit-transform": "none",
                "transform": "translateX(0)"
              }
            },
            "@keyframes marqueeAnimation-Right": {
              "0%": {
                "transform": "translateX(0)"
              },
              "100%": {
                "transform": "translateX(-3345.64px)"
              }
            },
            ".fadeInRight": {
              "animation-name": "fadeInRight",
              "animation-duration": "3s"
            },
            ".marqueeAnimationRight": {
              "animation-duration": "3s",
              "width": "100000px",
              "animation": "30s linear 0s infinite",
              "animation-name": "marqueeAnimation-Right"
            },
