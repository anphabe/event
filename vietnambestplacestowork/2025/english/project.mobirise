        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".list-group-item": {
              "background-color": "transparent",
              "padding": ".5rem 3.25rem"
            },
            ".plan-body": {
              "padding-bottom": "1.4rem",
              "padding-top": "3rem!important",
              "height": "100%",
              "background-color": "#fff"
            },
            ".plan-header": {
              "flex-direction": "column",
              "justify-content": "center",
              "align-self": "stretch",
              "align-items": "center",
              "min-height": "272px",
              "padding": "40px 20px 30px",
              "display": "flex",
              "position": "relative"
            },
            ".plan": {
              "height": "100%",
              "padding-bottom": "2.5rem",
              "word-break": "break-word",
              "background": "#fff",
              "box-shadow": "0 8px 32px 0 rgba(31, 38, 135, 0.37)",
              "backdrop-filter": "blur(20px)",
              "-webkit-backdrop-filter": "blur(20px)",
              ".list-group-item": {
                "position": "relative",
                "justify-content": "center",
                "border": "0",
                "&::after": {
                  "position": "absolute",
                  "bottom": "1px",
                  "left": "25%",
                  "width": "50%",
                  "height": "1px",
                  "content": "\"\"",
                  "background-color": "rgba(0, 0, 0, 0.1)"
                },
                "&:last-child::after": {
                  "display": "none"
                }
              },
              "display": "flex",
              "-webkit-box-orient": "vertical",
              "-webkit-box-direction": "normal",
              "-ms-flex-direction": "column",
              "flex-direction": "column"
            },
            "@media (max-width: 991px)": {
              ".plan": {
                "margin-bottom": "2rem"
              }
            },
            ".gt-heading.gt-align-center .gt-separate": {
              "justify-content": "center"
            },
            ".gt-separate": {
              "align-items": "center",
              "display": "flex",
              "margin": "3px auto 0",
              "justify-content": "center"
            },
            ".gt-separate:before, .gt-separate:after": {
              "content": "''",
              "display": "block",
              "height": "1px",
              "width": "125px",
              "background": "currentColor",
              "opacity": ".15"
            },
            ".gt-separate svg": {
              "margin": "0 20px",
              "width": "23px",
              "height": "auto",
              "opacity": ".15"
            },
            ".title": {
              "text-align": "center"
            },
            "a.text-primary:link, a.text-primary:hover, a.text-primary:visited, a.text-primary:active": {
              "color": "#353535!important"
            },
            ".highlight": {
              "color": "#99ca3c"
            },
            ".mbr-section-title": {
              "color": "#3a4c68",
              "text-align": "center"
            },
            ".note": {
              "font-size": "0.8rem"
            },
            "@media (max-width: 768px)": {
              ".plan-list.mb-4": {
                "margin-bottom": "0 !important"
              },
              ".price": {
                "font-size": "2.5rem"
              },
              ".gt-separate.mb-3": {
                "margin-bottom": "0 !important"
              },
              "padding-bottom": "(@paddingBottom * 0.5rem)",
              "padding-top": "1.5rem",
              ".plan-body": {
                "padding-top": "0!important"
              },
              ".space": {
                "margin-bottom": "2rem"
              }
            },
            "H6": {
              "color": "#000000"
            },
            "H4": {
              "color": "#3a4c68"
            },
            "ul": {
              "list-style-type": "none",
              "color": "#ffffff",
              "padding": "2rem 4rem",
              "@media (max-width: 768px)": {
                "padding-bottom": "0"
              }
            },
            "ul li": {
              "line-height": "1.8",
              "padding-left": "2rem",
              "position": "relative"
            },
            "#countdown,#datecount": {
              "font-weight": "bold",
              "font-size": "15px"
            },
            "#datecount": {
              "margin-right": "15px",
              "position": "relative"
            },
            "#datecount::after": {
              "content": "\"\"",
              "position": "absolute",
              "right": "-0.5rem",
              "top": "50%",
              "transform": "translateY(-50%)",
              "width": "1px",
              "height": "20px",
              "background-color": "#ccc"
            },
            ".plan:hover": {
              "transform": "scale(1.05) !important"
            },
            ".row:hover .plan:not(:hover)": {
              "transform": "scale(0.95) !important"
            },
            "@media (min-width: 768px)": {
              ".plan": {
                "transition": "400ms"
              }
            },
            ".pricecount": {
              "color": "#99ca3c"
            },
            ".price-term": {
              "color": "#77a421"
            },
            ".standard": {
              "padding": "4rem 2rem",
              "background": "linear-gradient(169deg, rgba(3, 16, 75, 1) 48%, rgba(66, 95, 195, 1) 89%, rgba(123, 83, 174, 1) 98%)"
            },
            ".early-bird": {
              "background": "linear-gradient(169deg, rgba(3, 16, 75, 1) 7%, rgba(8, 112, 150, 1) 41%, rgba(86, 167, 97, 1) 84%)",
              "padding": "4rem 2rem!important"
            },
            ".early-bird-2": {
              "background": "linear-gradient(55deg, rgba(8, 112, 150, 1) 0%, rgba(59, 6, 115, 1) 25%, rgba(98, 10, 53, 1) 72%, rgba(3, 16, 75, 1) 100%)",
              "padding": "4rem 2rem!important"
            },
            ".display-7": {
              "line-height": "1.4"
            },
            ".mbri-success": {
              "font-size": "1rem",
              "margin-right": "1rem",
              "margin-top": "0.5rem",
              "font-weight": "700",
              "top": "0",
              "left": "2px",
              "position": "absolute"
            },
            ".plan-title": {
              "color": "#00ffff"
            },
            ".white-color": {
              "color": "#fff!important"
            },
            "P": {
              "color": "#00ffff"
            },
            ".price": {
              "font-family": "Arial, Helvetica, sans-serif !important",
              "line-height": "1.3!important",
              "color": "#3a4c68"
            },
            "hr": {
              "width": "80%",
              "margin": "1rem auto"
            },
            "UL": {
              "text-align": "left",
              "color": "#3a4c68"
            },
            ".price-s": {
              "font-size": "1.2rem!important",
              "text-decoration-line": "line-through",
              "color": "#3a4c68!important"
            },
            ".price-s2": {
              "font-size": "1.2rem!important"
            },
            ".mbr-section-btn": {
              "bottom": "2rem"
            },
            ".plan-footer": {
              "margin-top": "auto"
            },
            ".btn-closed": {
              "color": "#686868!important"
            },
            ".img": {
              "z-index": "1",
              "border-top-left-radius": "16px",
              "border-top-right-radius": "16px",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "left": "0"
            },
            ".img img": {
              "object-fit": "cover"
            },
            ".header-text": {
              "z-index": "2",
              "position": "relative"
            },
            ".fs-small": {
              "font-size": "14px"
            },
            "svg": {
              "width": "100%",
              "height": "auto",
              "display": "block"
            },
            ".svg-tag": {
              "z-index": "2",
              "width": "112px",
              "height": "auto",
              "position": "absolute",
              "top": "-6px",
              "right": "-6px"
            },
            ".soldout": {
              "pointer-events": "none"
            }
          },
          "_name": "pricing2",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" group=\"Pricing Tables\" class=\"pricing2\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input inline type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input inline type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <select title=\"Amount\" name=\"itemsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/bg-coverhomepage-2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#cfd9df\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-start\">\n            <div class=\"title col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-3\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>TICKET PRICING</b></h3>\n                \n            </div>          \n                        \n            <div class=\"col-12 col-md-6 align-center space\" mbr-if=\"itemsAmount > 1\" mbr-class=\"{'col-lg-4': itemsAmount == 3,\n                                            'col-lg-6': itemsAmount == 2,\n                                            'col-lg-3': itemsAmount == 4}\">\n                <div class=\"plan\"> \n                    <svg class=\"svg-tag\" id=\"a\" data-name=\"Layer 1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 91.1 91.1\">\n  <polygon points=\"7.5 0 0 5.8 15 5.8 7.5 0\" style=\"fill: #565656;\"></polygon>\n  <polygon points=\"91.1 84.2 85.3 77.3 85.3 91.1 91.1 84.2\" style=\"fill: #565656;\"></polygon>\n  <polygon points=\"91.1 48 91.1 84.3 7.5 0 42.9 0 91.1 48\" style=\"fill: #aaa;\"></polygon>\n  <text transform=\"translate(39.24 18.47) rotate(45)\" style=\"fill: #fff; font-family: ShopeeDisplay-Bold, 'Shopee Display'; font-size: 10px; font-weight: 700;\"><tspan x=\"0\" y=\"0\" style=\"letter-spacing: 0em;\">S</tspan><tspan x=\"5.54\" y=\"0\">OLD OU</tspan><tspan x=\"42.44\" y=\"0\" style=\"letter-spacing: -.04em;\">T</tspan></text>\n</svg>\n                    <div class=\"plan-header\">\n                        <div class=\"header-text\">\n                            <h4 class=\"mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\"><b>EARLY BIRD</b></h4>                        \n                            <div class=\"plan-price\">\n                                <p mbr-text class=\"price price-s mbr-fonts-style m-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price\">8.000.000<span style=\"font-size: 1.2rem\">VND/ticket</span></p>\n                                <p mbr-text class=\"price mbr-fonts-style m-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price\"><b>6.400.000<span style=\"font-size: 14px;\">VND/ticket</span></b></p>\n                                <p mbr-text class=\"price-term mbr-fonts-style mb-3 mt-3\" mbr-theme-style=\"display-7\" data-app-selector=\".price-term\">until 31 Oct 2025<br></p>\n                            </div>\n                        </div>\n                        <div class=\"img\">\n                            <img decoding=\"async\" src=\"@PROJECT_PATH@/assets/images/bg-pricing-1-01.jpg\" class=\"object-cover\" alt=\"Đăng ký sớm<br>Vé toàn bộ sự kiện\" loading=\"lazy\" title=\"CODE THE FUTURE\">\n                        </div>\n                    </div>\n                    <div class=\"plan-body\" id=\"early-price-plan\">\n                        <div class=\"plan-list mb-4\">\n                            <ul mbr-text class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <li>\n                                    <span class=\"mbri-success\"></span>Full in-person access</li>\n                                <li>\n                                    <span class=\"mbri-success\"></span>Refreshment break</li>\n                                <li>\n                                    <span class=\"mbri-success\"></span>Gala dinner</li><li><span class=\"mbri-success\"></span>Event materials</li>                  \n                            </ul>\n                        </div>                                               \n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn text-center gr plan-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn gr btn-success soldout\" data-app-placeholder=\"Type Text\">REGISTER NOW</a></div> \n                </div>\n            </div>\n\n            <div class=\"col-12 col-md-6 align-center space\" mbr-if=\"itemsAmount > 1\" mbr-class=\"{'col-lg-4': itemsAmount == 3,\n                                            'col-lg-6': itemsAmount == 2,\n                                            'col-lg-3': itemsAmount == 4}\">\n                <div class=\"plan\">\n                    <svg class=\"svg-tag\" width=\"112\" height=\"112\" id=\"Layer_1\" data-name=\"Layer 1\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 92.2 91.1\">                      \n                        <polygon points=\"8.6 0 1.1 5.8 16.1 5.8 8.6 0\" fill=\"#054405\"></polygon>\n                        <polygon points=\"92.2 84.2 86.4 77.3 86.4 91.1 92.2 84.2\" fill=\"#054405\"></polygon>\n                        <polygon points=\"92.2 48 92.2 84.3 8.6 0 44 0 92.2 48\" fill=\"green\"></polygon>\n                        <text transform=\"translate(28.66 9.5) rotate(45)\" fill=\"#fff\" font-family=\"ShopeeDisplay-Bold, 'Shopee Display'\" font-size=\"9\" font-weight=\"700\"><tspan x=\"0\" y=\"0\">E</tspan><tspan x=\"5.3\" y=\"0\" letter-spacing=\"-.08em\">X</tspan><tspan x=\"10.81\" y=\"0\">C</tspan><tspan x=\"17.19\" y=\"0\" letter-spacing=\"-.08em\">L</tspan><tspan x=\"21.03\" y=\"0\" letter-spacing=\"-.02em\">U</tspan><tspan x=\"27.22\" y=\"0\">SIVE </tspan><tspan x=\"48.77\" y=\"0\" letter-spacing=\"0em\">O</tspan><tspan x=\"55.59\" y=\"0\" letter-spacing=\"0em\">FFER</tspan></text>\n                    </svg>\n                    <div class=\"plan-header\">\n                        <div class=\"header-text\">\n                            <h4 class=\"mbr-fonts-style mb-0 aqua\" mbr-theme-style=\"display-5\"><b>GROUP OFFER</b></h4>                        \n                            <div class=\"plan-price\">\n                                <p mbr-text class=\"price price-s mbr-fonts-style m-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price\">8.000.000<span style=\"font-size: 1.2rem\">VND/ticket</span></p>\n                                <p mbr-text class=\"price mbr-fonts-style m-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price\"><b>6.400.000</b><span class=\"fs-small\">VND/ticket</span></p>\n                                <p mbr-text class=\"price-term mbr-fonts-style mb-3 mt-3\" mbr-theme-style=\"display-7\" data-app-selector=\".price-term\"><span style=\"color: #77a421\">Groups of&nbsp;<b>3+</b></span></p>\n                            </div>\n                        </div>\n                        <div class=\"img\">\n                            <img decoding=\"async\" src=\"@PROJECT_PATH@/assets/images/bg-pricing-1-01.jpg\" class=\"object-cover\" alt=\"Ưu đãi theo nhóm\" loading=\"lazy\" title=\"CODE THE FUTURE\">\n                        </div>\n                    </div>\n                    \n                    <div class=\"plan-body\" id=\"early-price-plan\">\n                        <div class=\"plan-list mb-4\">\n                            <ul mbr-text class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                                <li>\n                                    <span class=\"mbri-success\"></span>Full in-person access</li>\n                                <li>\n                                    <span class=\"mbri-success\"></span>Refreshment break</li>\n                                <li>\n                                    <span class=\"mbri-success\"></span>Gala dinner</li>\n                                <li>\n                                    <span class=\"mbri-success\"></span>Event materials</li>                  \n                            </ul>\n                        </div>                              \n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn text-center gr plan-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn gr btn-danger\" data-app-placeholder=\"Type Text\" href=\"https://event-register.anphabe.com/register.en.html\">REGISTER NOW</a></div>       \n                </div>\n            </div>\n\n            <div class=\"col-12 col-md-6 align-center space\" mbr-class=\"{'col-lg-4': itemsAmount == 3,\n                                            'col-lg-6': itemsAmount == 2,\n                                            'col-lg-3': itemsAmount == 4}\">\n                <div class=\"plan\">\n                    <div class=\"plan-header\">\n                        <div class=\"header-text\">\n                            <h4 class=\"mbr-fonts-style mb-0 aqua\" mbr-theme-style=\"display-5\"><b>STANDARD</b></h4>\n                            <div class=\"plan-price\">\n                                <p mbr-text class=\"price mbr-fonts-style m-0\" mbr-theme-style=\"display-2\" data-app-selector=\".price\"><b>8.000.000</b><span class=\"fs-small\">VND/ticket</span></p>\n                            </div>\n                        </div>\n                        <div class=\"img\">\n                            <img decoding=\"async\" src=\"@PROJECT_PATH@/assets/images/bg-cover-pricing-01.png\" class=\"object-cover\" alt=\"Đăng ký sớm<br>Vé toàn bộ sự kiện\" loading=\"lazy\" title=\"CODE THE FUTURE\">\n                        </div>\n                    </div>\n                    <div class=\"plan-body\">\n                        <div class=\"plan-list mb-4\">\n                            <ul mbr-text class=\"mbr-fonts-style\" mbr-theme-style=\"display-7\">     \n                                <li>\n                                    <span class=\"mbri-success\"></span>Full in-person access</li>                           \n                                <li>\n                                    <span class=\"mbri-success\"></span>Refreshment break</li>\n                                <li>\n                                    <span class=\"mbri-success\"></span>Gala dinner</li>\n                                <li>\n                                    <span class=\"mbri-success\"></span>Event materials</li>            \n                            </ul>\n                        </div>    \n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn text-center gr plan-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn gr btn-danger\" data-app-placeholder=\"Type Text\" href=\"https://event-register.anphabe.com/register.en.html\">REGISTER NOW</a></div> \n                </div>\n            </div>\n        </div>\n    </div>\n    [JS_CODE_0]\n</section>",
          "_cid": "thY5j53c25",
          "_anchor": "ticket",
          "_PHPplaceholders": [],
          "_JSplaceholders": [
            "<script>\n      function updateCountdown(targetDate) {\n      const now = new Date().getTime();\n      const distance = targetDate - now;\n\n      const days = Math.floor(distance / (1000 * 60 * 60 * 24)).toString().padStart(2, '0');\n      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)).toString().padStart(2, '0');\n      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)).toString().padStart(2, '0');\n      const seconds = Math.floor((distance % (1000 * 60)) / 1000).toString().padStart(2, '0');\n\n          document.getElementById('countdown').innerHTML =\n              `${days} : ${hours} : ${minutes} : ${seconds}`;\n\n          if (distance < 0) {\n              clearInterval(countdownInterval);\n              document.getElementById('countdown').innerHTML = \"EXPIRED\";\n          }\n      }\n\n      const targetDate = new Date(\"Oct 16, 2024 00:00:00\").getTime();\n      const countdownInterval = setInterval(() => {\n          updateCountdown(targetDate);\n      }, 1000);\n\n      updateCountdown(targetDate);\n    </script>"
          ],
