        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".text-wrapper": {
                "padding": "1rem"
              }
            },
            "@media (max-width: 991px)": {
              ".image-wrapper": {
                "margin-bottom": "1rem"
              }
            },
            "img": {
              "width": "100%"
            },
            "@media (min-width: 992px)": {
              ".text-wrapper": {
                "padding": "0 2rem"
              }
            },
            ".mbr-section-subtitle": {
              "text-align": "left",
              "color": "#3a4c68"
            },
            ".mbr-section-title": {
              "color": "#3a4c68"
            },
            "ul": {
              "padding-left": "1rem"
            },
            "@media (max-width: 768px)": {
              "padding-top": "(@paddingTop * 0.5rem)",
              "padding-bottom": "(@paddingBottom * 0.5rem)",
              ".txt": {
                "padding-left": "0rem"
              },
              ".text-wrapper": {
                "padding-left": "0rem"
              },
              ".video-wrapper": {
                "padding-left": "0rem",
                "padding-right": "0rem"
              }
            },
            ".btn": {
              "text-transform": "uppercase"
            }
          },
          "_name": "image2",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"image2\" group=\"Images & Videos\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" name=\"textWidth\" title=\"Image\" min=\"4\" max=\"8\" step=\"1\" value=\"6\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDescription\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#cfd9df\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-class=\"{'col-lg' : !fullWidth, 'col-lg-4' : fullWidth &amp;&amp; textWidth >= 6, 'col-lg-6' : fullWidth &amp;&amp; textWidth <= 5}\">\n                <div class=\"text-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>Vietnam Best Places to Work® Summit 2025 is where a community of pioneering business leaders join force to imagine the future and  turn vision into action. Join us to CODE THE FUTURE together!</b></h3>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"txt\">\n                   \n                    <ul class=\"list mbr-fonts-style mb-3\" mbr-theme-style=\"display-7\" data-app-selector=\".list\" data-multiline mbr-article>\n                        <li>The future isn’t waiting. How is it being coded right now - By leaders, by culture, or by the choices we make today?</li><li>If AI is rewriting the rules, then who is writing the future of people?</li><li>From skill to will, from technology to leadership - Which strategies will bold organizations apply to rewrite the code of tomorrow?</li>\n                    </ul>\n                     <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Join us</h5>\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>CODE THE FUTURE</b></h3>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">“CODE THE FUTURE” isn’t about algorithms alone but reprogramming how we work, lead and inspire.<br></p>\n                    <div class=\"mbr-section-btn mb-4\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-danger\" href=\"https://event-register.anphabe.com/register.en.html\" data-app-placeholder=\"Type Text\">Register Now</a></div>\n                </div>\n                <div mbr-video class=\"video-wrapper\">\n                    <iframe src=\"https://www.youtube.com/watch?v=HPhh9aPsiCg&loop=1&autoplay=1\" style=\"border:none;overflow:hidden\" scrolling=\"no\" frameborder=\"0\" allowfullscreen=\"true\" allow=\"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share\"></iframe>\n                </div>\n            </div>\n            \n        </div>\n    </div>\n</section>",
          "_cid": "uVHQPOKfCQ",
          "_anchor": "diemnhan",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".timelines-container": {
              "display": "flex",
              "flex-wrap": "wrap",
              "& when (@reverseTimeline)": {
                "flex-direction": "column-reverse"
              }
            },
            ".timeline-element": {
              "position": "relative"
            },
            ".image-wrapper img": {
              "width": "100%",
              "object-fit": "cover"
            },
            ".iconBackground": {
              "position": "absolute",
              "left": "33.33%",
              "width": "20px",
              "height": "20px",
              "border-radius": "50%",
              "border": "2px solid @lineColor",
              "top": "30px",
              "margin-left": "-9px",
              "padding": "0"
            },
            ".separline": {
              "border-bottom": "solid 1px #7e909e",
              "padding-bottom": "2rem!important",
              "width": "100%"
            },
            "@media (max-width: 767px)": {
              ".iconBackground": {
                "left": "15px !important"
              },
              ".separline:before": {
                "left": "15px !important"
              },
              ".card-box": {
                "padding": "1rem",
                "padding-left": "0!important"
              }
            },
            ".mbr-section-title, .mbr-section-subtitle": {
              "text-align": "center"
            },
            ".time-line-date-content": {
              "@media (max-width: 767px)": {
                "margin-left": "0rem",
                "margin-bottom": "1.5rem",
                ".mbr-timeline-date": {
                  "text-align": "left"
                }
              },
              "@media (min-width: 768px)": {
                "margin-right": "1rem",
                ".mbr-timeline-date": {
                  "text-align": "left"
                }
              }
            },
            ".reverseTimeline": {
              "display": "flex",
              "flex-direction": "column-reverse"
            },
            ".mbr-timeline-date": {
              "color": "#ffffff"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-timeline-title": {
              "color": "#ffffff"
            },
            ".item:not(:nth-last-child(1))": {
              "margin-bottom": "2rem"
            },
            ".item-wrapper": {
              "border-radius": "4px"
            },
            "@media (min-width: 768px)": {
              ".card-box": {
                "padding-right": "2rem"
              }
            },
            "@media (min-width: 992px)": {
              ".card-box": {
                "padding-left": "0rem",
                "padding-right": "0rem"
              }
            },
            ".card-title": {
              "color": "#fbfbfb"
            },
            ".mbr-timeline-text": {
              "color": "#ffffff"
            },
            ".mbr-section-subtitle": {
              "color": "#99ca3c",
              "text-align": "center"
            },
            ".card-subtitle": {
              "color": "#ffffff"
            },
            ".mbr-text, .social-row": {
              "color": "#cfd9df"
            },
            "@media (max-width: 768px)": {
              ".timeline-text-content": {
                "margin-top": "1.5rem"
              },
              "padding-top": "2rem!important",
              "padding-bottom": "2rem!important"
            },
            ".nav-tabs .nav-item.open .nav-link:focus, .nav-tabs .nav-link.active:focus": {
              "outline": "none"
            },
            ".nav-tabs": {
              "flex-wrap": "wrap",
              "border-bottom": "none",
              "border": "none"
            },
            ".nav-item": {
              "@media (max-width: 767px)": {
                "width": "100%",
                "margin": "0"
              }
            },
            ".nav-tabs .nav-link": {
              "transition": "all .5s",
              "border": "none",
              "border-bottom": "0",
              "border-radius": "0 !important",
              "&:not(.active)": {
                "color": "@tabsColor"
              }
            },
            ".nav-tabs .nav-item": {
              "margin-right": "1.5rem"
            },
            ".nav-link, .nav-link.active": {
              "padding": "1rem 0",
              "background-color": "transparent"
            },
            ".nav-tabs .nav-link.active": {
              "color": "@activeColor",
              "border-bottom": "none"
            },
            ".nav-tabs .nav-link:not(.active)": {
              "color": "#fff!important",
              "opacity": "0.4"
            },
            "p": {
              "margin-bottom": "0"
            },
            ".line": {
              "border-bottom": "1px solid #7e909e"
            }
          },
          "_name": "timeline2",
          "_sourceTheme": "mobirise5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs timeline2\" group=\"Timelines, Content\" data-bg-video=\"{{bg.type == 'video' &&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\" plugins=\"mbr-tabs\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse Timeline\" name=\"reverseTimeline\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Dates\" name=\"showDates\" checked>\n        <input type=\"checkbox\" title=\"Images\" name=\"showImages\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <select title=\"Count\" name=\"timelinesAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\">8</option>\n            <option value=\"9\">9</option>\n            <option value=\"10\">10</option>\n            <option value=\"11\" selected>11</option>\n            <option value=\"12\">12</option>\n        </select>\n        <input type=\"color\" name=\"lineColor\" title=\"Color\" value=\"#6592e6\">\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"color\" name=\"tabsColor\" title=\"Color\" value=\"#000000\">\n        <input type=\"color\" name=\"activeColor\" title=\"Active Color\" value=\"#99ca3c\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#3a4c68\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background13.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay &&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay &&bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head\" mbr-if=\"showTitle || showSubtitle\">\n            <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">\n                <b>AGENDA</b></h3>            \n        </div>\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-{{textWidth}}\">\n                <ul class=\"nav nav-tabs mb-4 justify-content-center\" role=\"tablist\">\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item first mbr-fonts-style align-center\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style show active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#agenda_tab0\" data-app-placeholder=\"Type Text\" aria-selected=\"true\"><strong style=\"font-size: 1.8rem\">Afternoon session</strong><br>[12:00 - 17:30]</a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item align-center\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#agenda_tab1\" data-app-placeholder=\"Type Text\" aria-selected=\"true\"><strong style=\"font-size: 1.8rem\">Evening session</strong><br>[17:30 - 21:00]</a></li>\n                    \n                </ul>\n                <div class=\"tab-content\">\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                        <div class=\"timelines-container mt-4\">\n                            <div class=\"row timeline-element separline mb-5\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>12:00 - 13:00</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row align-items-center\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/1.jpg\" alt=\"Đón khách và giao lưu\">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-md-6\">\n                                    <div class=\"timeline-text-content\">\n                                        <h4 class=\"mbr-timeline-title mb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>Registration</b> <span style=\"font-family: Arial, sans-serif;\">&amp;</span> <b>networking</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                                Explore the Future Bar <span style=\"font-family: Arial, sans-serif;\">&amp;</span> Future Hub</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row timeline-element separline mb-5\" mbr-if=\"timelinesAmount>1\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>13:00 - 13:15</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row align-items-center\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/2.jpg\" alt=\"Khai mạc hội nghị và lễ vinh danh\">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-md-6\">\n                                    <div class=\"timeline-text-content\">\n                                        <h4 class=\"mbr-timeline-title mb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>Summit opening <span style=\"font-family: Arial, sans-serif;\">&amp;</span> recognition ceremony</b></h4>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row timeline-element separline mb-5\" mbr-if=\"timelinesAmount>2\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>13:15 - 14:25</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/3.jpg\" alt=\"Ms. THANH NGUYEN\">\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-8 col-md-8\">\n                                                        <div class=\"card-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style m-0 mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                                                Ms. <b>THANH NGUYEN</b></h5>\n                                                            <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">Chief Happiness Officer<br>Anphabe<br></h6>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                                <div class=\"row align-items-center mt-2\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/4.jpg\" alt=\"Ms. LUU BAO VAN\">\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-8 col-md-8\">\n                                                        <div class=\"card-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style m-0 mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                                                Ms. <b>LUU BAO VAN</b></h5>\n                                                            <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">Research Director<br>Intage Vietnam<br></h6>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-md-6 align-items-center\">\n                                    <div class=\"timeline-text-content\">\n                                        <p class=\"mbr-text mbr-fonts-style mb-2\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Exclusive deep-dive report from Vietnam Best Places To Work® 2025 Survey</p>\n                                        <h4 class=\"mbr-timeline-title mb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>CODE THE FUTURE</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style mb-2\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">AI and automation are rewriting the rules of work, organizations in Vietnam face a defining set of strategic questions: Where do we stand on the “Lean &amp; Learn” map? What are the “system bugs” preventing true organizational readiness? And most importantly, is it time to move beyond the old paradigms and proactively code the future we aspire to build?</p>\n                                        <p class=\"mbr-text mbr-fonts-style mb-2\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">The CODE THE FUTURE report unveils a comprehensive view of how Organizations are reprogramming for the new world of work in Vietnam, grounded in insights from tens of thousands of employees and hundreds of senior leaders nationwide. More than a data report, it is a call to action for visionary leaders ready to code the future with agility, foresight, and a steadfast belief in the power of people.\"</p>\n\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row timeline-element separline mb-5\" mbr-if=\"timelinesAmount>3\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>14:25 - 14:45</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row align-items-center\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/8.jpg\" alt=\"Ms. RACHELE FOCARDI\">\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-8 col-md-8\">\n                                                        <div class=\"card-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style m-0 mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                                                Ms. <b>RACHELE FOCARDI</b></h5>\n                                                            <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">Global Expert &amp; Keynote Speaker; LinkedIn Top Voice; Top 6 Most Influential Women in the New World of Work; Member of MENSA International (The largest and oldest high-IQ society in the world)</h6>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-md-6\">\n                                    <div class=\"timeline-text-content\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">Anpha Talk</p>\n                                        <h4 class=\"mbr-timeline-title mb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>CRACKING THE INNOVATION CODE: HOW GENERATIONS POWER THE FUTURE OF WORK</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style mb-2\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">Innovation is often seen as the product of technology - but in reality, it’s powered by people. With Boomers, Gen X, Millennials, and Gen Z working side by side, the greatest untapped source of innovation lies in generational diversity. Each generation brings unique strengths, from experience and pragmatism to agility and fresh perspectives.</p>\n                                        <p class=\"mbr-text mbr-fonts-style mb-2\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">This session reveals how organizations can crack the innovation code by harnessing these differences, breaking stereotypes, and building cross-generational teams that fuel creativity, resilience, and future growth.</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row timeline-element separline mb-5\" mbr-if=\"timelinesAmount>4\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>14:45 - 15:45</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/18-1.jpg\" alt=\"Ms. TRINH MAI PHUONG\">\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-8 col-md-8\">\n                                                        <div class=\"card-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style m-0 mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Ms. <b>TRINH MAI PHUONG</b></h5>\n                                                            <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">Personal Care HR Lead, Unilever Greater Asia<br>Vietnam Head of HR, Unilever Vietnam</h6>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                                <div class=\"row align-items-center mt-2\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/19.jpg\" alt=\"Mr. NGUYEN VIET HA\">\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-8 col-md-8\">\n                                                        <div class=\"card-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style m-0 mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Mr. <b>NGUYEN VIET HA</b></h5>\n                                                            <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">General Manager<br>PepsiCo Foods Vietnam</h6>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                                <div class=\"row align-items-center mt-2\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/21.jpg\" alt=\"Mr. NGUYEN TRUONG HAI\">\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-8 col-md-8\">\n                                                        <div class=\"card-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style m-0 mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Mr.&nbsp;<b>NGUYEN TRUONG HAI</b></h5>\n                                                            <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">CEO<br>Saint-Gobain Vietnam</h6>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                                <div class=\"row align-items-center mt-2\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/22-1.jpg\" alt=\"Ms. DO THUY DUONG\">\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-8 col-md-8\">\n                                                        <div class=\"card-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style m-0 mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Ms.&nbsp;<b>DO THUY DUONG</b></h5>\n                                                            <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">Founder &amp; CEO<br>The MAP</h6>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                                <div><h6 class=\"card-subtitle mbr-fonts-style mb-1 mt-3 line\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">Moderator</h6></div>\n                                                <div class=\"row align-items-center mt-2\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/20.jpg\" alt=\"Ms. CAP THI MINH TRANG\">\n                                                        </div>\n                                                    </div>\n                                                    <div class=\"col-8 col-md-8\">\n                                                        <div class=\"card-box\">\n                                                            <h5 class=\"card-title mbr-fonts-style m-0 mb-2\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Ms. <b>CAP THI MINH TRANG</b></h5>\n                                                            <h6 class=\"card-subtitle mbr-fonts-style mb-3\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">HR Director, Schneider Electric Vietnam &amp; Cambodia</h6>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>   \n                                </div>\n                                <div class=\"col-12 col-md-6\">\n                                    <div class=\"timeline-text-content\">\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-7\" mbr-if=\"showText\">C-Suite</p>\n                                        <h4 class=\"mbr-timeline-title mb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>The New Leadership Code: Redesigning the Human Algorithm</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style mb-2\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\"><b>In an era where data drives decisions and AI rewrites work, leadership itself needs a reboot.</b></p>\n                                        <p class=\"mbr-text mbr-fonts-style mb-2\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">The new leadership code isn’t about managing more. It’s about mastering the human algorithm: the ability to think clearly, trust deeply, and lead through paradox.</p>\n                                        <p class=\"mbr-text mbr-fonts-style mb-2\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">Join Anphabe CODE THE FUTURE C-SUITE PANEL to explore how the next generation of leaders is coding the future of work and the future of us.</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row timeline-element separline mb-5\" mbr-if=\"timelinesAmount>5\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>15:45 - 16:30</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row align-items-center\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/7.jpg\" alt=\" Tiệc trà & giao lưu\">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"col-12 col-md-6\">\n                                    <div class=\"timeline-text-content\">\n                                        <h4 class=\"mbr-timeline-title mb-2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>Tea break <span style=\"font-family: Arial, sans-serif;\">&amp;</span> networking</b></h4>\n                                        <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text, .social-row\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                                Explore the Future Bar <span style=\"font-family: Arial, sans-serif;\">&amp;</span> Future Hub</p>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"row timeline-element separline mb-5\" mbr-if=\"timelinesAmount>6\">\n                                <div class=\"timeline-date-panel col-12 col-md-2\">\n                                    <div class=\"time-line-date-content\">\n                                        <h4 class=\"mbr-timeline-date mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showDates\" data-app-selector=\".mbr-timeline-date\"><b>16:30 - 17:30</b></h4>\n                                    </div>\n                                </div>                \n                                <div class=\"col-12 col-md-4\">\n                                    <div class=\"timeline-profile\">\n                                        <div class=\"item features-image\">\n                                            <div class=\"item-wrapper\">\n                                                <div class=\"row align-items-center\">\n                                                    <div class=\"col-4 col-md-4\">\n                                                        <div class=\"image-wrapper d-flex align-items-center\">\n                                                            <img src=\"@PROJECT_PATH@/assets/images/14.jpg\" alt=\"Lễ vinh danh 100 NƠI LÀM VIỆC TỐT NHẤT VIỆT NAM® 2025\">\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                        